    "create.style.logoHint": {
      "comment": "Nota sobre o ícone",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغطي الشعار جزءًا من الرمز، لذا تُضبط تصحيح الأخطاء على الحد الأقصى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoet dækker en del af koden, så fejlretningen er sat til maksimum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Logo verdeckt einen Teil des Codes, daher wird die Fehlerkorrektur auf Maximum gesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo covers part of the code, so error correction is set to maximum to keep it scannable."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo covers part of the code, so error correction is set to maximum to keep it scannable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El logotipo tapa parte del código, así que la corrección de errores se ajusta al máximo para que siga siendo legible."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El logotipo tapa parte del código, así que la corrección de errores se ajusta al máximo para que siga siendo legible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo peittää osan koodista, joten virheenkorjaus on asetettu suurimmaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logo masque une partie du code : la correction d'erreur est réglée au maximum pour qu'il reste lisible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logo masque une partie du code : la correction d'erreur est réglée au maximum pour qu'il reste lisible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוגו מכסה חלק מהקוד, לכן תיקון השגיאות מוגדר למקסימום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगो कोड का हिस्सा ढकता है, इसलिए त्रुटि सुधार अधिकतम पर सेट है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo menutupi sebagian kode, jadi koreksi kesalahan diatur maksimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il logo copre parte del codice: la correzione degli errori è al massimo per mantenerlo leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンでコードの一部が隠れるため、誤り訂正レベルを最大にして読み取れるようにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고가 코드 일부를 가리므로 오류 정정이 최대로 설정됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo menutupi sebahagian kod, jadi pembetulan ralat ditetapkan maksimum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoen dekker en del av koden, så feilkorrigeringen er satt til maksimum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het logo bedekt een deel van de code, dus foutcorrectie staat op maximaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo zasłania część kodu, więc korekcja błędów jest ustawiona na maksimum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O logo cobre parte do código. A correção de erros fica no nível máximo para que a leitura continue funcionando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O logótipo tapa parte do código, por isso a correção de erros é definida no máximo para continuar legível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотип закрывает часть кода, поэтому коррекция ошибок установлена на максимум."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotypen täcker en del av koden, därför är felkorrigeringen maximal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลโก้บังโค้ดบางส่วน จึงตั้งการแก้ไขข้อผิดพลาดสูงสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo kodun bir kısmını kapladığı için hata düzeltme en yükseğe ayarlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотип закриває частину коду, тому корекція помилок встановлена на максимум."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo che một phần mã, nên khả năng sửa lỗi được đặt tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标会遮住部分码点。已自动调到最高纠错级别，照样能扫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標誌會遮住部分條碼，因此已將容錯等級設為最高以維持可掃描性。"
          }
        }
      }
    },
    "create.style.lowContrast": {
      "comment": "Aviso de contraste",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الألوان لا تتباين بما يكفي. قد لا يُمسح الرمز."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse farver har ikke nok kontrast. Koden kan måske ikke scannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Farben haben zu wenig Kontrast. Der Code wird evtl. nicht erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These colors don't contrast enough. The code may not scan."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These colours don't contrast enough. The code may not scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos colores no contrastan lo suficiente. Puede que el código no se escanee."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos colores no contrastan lo suficiente. Puede que el código no se escanee."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden värien kontrasti on liian pieni. Koodi ei ehkä skannaudu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces couleurs ne contrastent pas assez. Le code risque de ne pas être scanné."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces couleurs ne contrastent pas assez. Le code risque de ne pas être scanné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצבעים האלה לא מנוגדים מספיק. ייתכן שהקוד לא ייסרק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन रंगों में पर्याप्त कंट्रास्ट नहीं है। कोड स्कैन नहीं हो सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna ini kurang kontras. Kode mungkin tidak dapat dipindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi colori non hanno abbastanza contrasto. Il codice potrebbe non essere scansionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2色のコントラストが低いため、読み取れないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상은 대비가 충분하지 않습니다. 코드가 스캔되지 않을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna ini kurang kontras. Kod mungkin tidak dapat diimbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse fargene har ikke nok kontrast. Koden kan kanskje ikke skannes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kleuren hebben te weinig contrast. De code wordt mogelijk niet gescand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te kolory mają zbyt mały kontrast. Kod może się nie skanować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas duas cores têm pouco contraste, e o código pode não ser lido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cores não têm contraste suficiente. O código pode não ser lido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточный контраст. Код может не считываться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa färger har för låg kontrast. Koden kanske inte kan skannas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเหล่านี้ตัดกันไม่พอ โค้ดอาจสแกนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu renklerin kontrastı yetersiz. Kod taranmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатній контраст. Код може не зчитуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu này không đủ tương phản. Mã có thể không quét được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这两种颜色对比度太低，可能扫不出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些顏色對比不足，條碼可能無法掃描。"
          }
        }
      }
    },
    "create.style.proHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين أنماط PRO كما تشاء. ما عليك سوى إلغاء قفلها للحفظ أو المشاركة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se PRO-stile så meget, du vil. Lås dem kun op for at gemme eller dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO-Stile beliebig oft ansehen. Zum Speichern oder Teilen musst du sie freischalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview PRO styles as much as you like. You only need to unlock them to save or share."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview PRO styles as much as you like. You only need to unlock them to save or share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza los estilos PRO todo lo que quieras. Solo tienes que desbloquearlos para guardar o compartir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza los estilos PRO todo lo que quieras. Solo tienes que desbloquearlos para guardar o compartir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatsele PRO-tyylejä vapaasti. Avaa ne vain tallentaaksesi tai jakaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apercevez les styles PRO autant que vous voulez. Débloquez-les seulement pour enregistrer ou partager."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Apercevez les styles PRO autant que vous voulez. Débloquez-les seulement pour enregistrer ou partager."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפה בסגנונות PRO כמה שתרצה. פתח אותם רק כדי לשמור או לשתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO शैलियों का जितना चाहें प्रीव्यू करें। सहेजने या साझा करने के लिए बस उन्हें अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau gaya PRO sebanyak yang Anda suka. Cukup buka kuncinya untuk menyimpan atau membagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima degli stili PRO quanto vuoi. Sbloccali solo per salvare o condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PROスタイルは自由にプレビューできます。購入が必要なのは保存・共有するときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO 스타일은 원하는 만큼 미리 볼 수 있습니다. 저장하거나 공유하려면 잠금만 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton gaya PRO sesuka hati. Hanya perlu buka kuncinya untuk simpan atau kongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvis PRO-stiler så mye du vil. Lås dem opp bare for å lagre eller dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk PRO-stijlen zo vaak je wilt. Ontgrendel ze alleen om op te slaan of te delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądaj style PRO do woli. Odblokuj je tylko, aby zapisać lub udostępnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ver a prévia dos estilos PRO; o desbloqueio só é pedido ao salvar ou compartilhar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualize estilos PRO à vontade. Só precisa de os desbloquear para guardar ou partilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите PRO-стили сколько угодно. Разблокируйте их только для сохранения и отправки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsgranska PRO-stilar hur mycket du vill. Lås upp dem bara för att spara eller dela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูตัวอย่างสไตล์ PRO ได้ไม่จำกัด เพียงปลดล็อกเพื่อบันทึกหรือแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO stillerini dilediğiniz kadar önizleyin. Kaydetmek veya paylaşmak için kilidini açmanız yeterli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте PRO-стилі скільки завгодно. Розблокуйте їх лише для збереження чи надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước kiểu PRO thoải mái. Chỉ cần mở khóa để lưu hoặc chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO 样式可以随便预览，存储或分享时才需要解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO 樣式可任意預覽，只有儲存或分享時才需要解鎖。"
          }
        }
      }
    },
