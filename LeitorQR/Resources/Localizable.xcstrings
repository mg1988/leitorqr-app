    "paywall.benefit.history.desc": {
      "comment": "Descrição do histórico ilimitado",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حد لعدد الإدخالات يبلغ 10 — احتفظ بكل رمز تقوم بمسحه ضوئيًا أو إنشائه"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen grænse på 10 indgange – behold hver kode, du scanner eller opretter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Beschränkung auf 10 Einträge – behalten Sie jeden Code, den Sie scannen oder erstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 10-entry limit—keep every code you scan or create"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No 10-entry limit—keep every code you scan or create"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite de 10 entradas: conserve todos los códigos que escanee o cree"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límite de 10 entradas: conserve todos los códigos que escanee o cree"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei 10 merkin rajoitusta – säilytä jokainen skannaamasi tai luomasi koodi"
