    "scanner.unavailable.message": {
      "comment": "Mensagem de câmara indisponível",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تشغيل الكاميرا على هذا الجهاز. يمكنك استيراد صورة بدلاً من ذلك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet kan ikke starte på denne enhed. Du kan importere et billede i stedet for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera kann auf diesem Gerät nicht gestartet werden. Sie können stattdessen ein Foto importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera can't start on this device. You can import a photo instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera can't start on this device. You can import a photo instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no puede iniciarse en este dispositivo. Puedes importar una foto en su lugar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no puede iniciarse en este dispositivo. Puedes importar una foto en su lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ei voi käynnistyä tällä laitteella. Voit tuoda sen sijaan valokuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra ne peut pas démarrer sur cet appareil. Vous pouvez importer une photo à la place."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra ne peut pas démarrer sur cet appareil. Vous pouvez importer une photo à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה לא יכולה להפעיל במכשיר זה. אתה יכול לייבא תמונה במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कैमरा प्रारंभ नहीं हो सकता. आप इसके बजाय एक फ़ोटो आयात कर सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak dapat memulai pada perangkat ini. Anda dapat mengimpor foto saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la fotocamera su questo dispositivo. Puoi invece importare una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラを起動できません。写真から読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서는 카메라를 시작할 수 없습니다. 대신 사진을 가져올 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak boleh dimulakan pada peranti ini. Anda boleh mengimport foto sebaliknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet kan ikke starte på denne enheten. Du kan importere et bilde i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera kan niet starten op dit apparaat. U kunt in plaats daarvan een foto importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić aparatu na tym urządzeniu. Zamiast tego możesz zaimportować zdjęcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a câmera neste dispositivo. Você pode importar uma foto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara não pode ser iniciada neste dispositivo. Pode importar uma foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается запустить камеру на этом устройстве. Вместо этого вы можете импортировать фотографию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran kan inte starta på den här enheten. Du kan importera ett foto istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องไม่สามารถเริ่มทำงานบนอุปกรณ์นี้ คุณสามารถนำเข้ารูปภาพแทนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera bu cihazda başlatılamıyor. Bunun yerine bir fotoğrafı içe aktarabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається запустити камеру на цьому пристрої. Натомість ви можете імпортувати фотографію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy ảnh không thể khởi động trên thiết bị này. Thay vào đó, bạn có thể nhập ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在这台设备上启动相机。你可以改为从照片导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機無法在此裝置上啟動。您可以匯入照片。"
          }
        }
      }
    },
