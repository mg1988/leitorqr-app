        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnées non valides. La latitude doit être comprise entre -90 et 90, et la longitude entre -180 et 180."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קואורדינטות לא תקינות. קו רוחב חייב להיות בין 90- ל-90, וקו אורך בין 180- ל-180."
