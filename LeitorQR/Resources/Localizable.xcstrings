    "create.format.footer": {
      "comment": "Limites dos códigos de barras",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرموز الشريطية (1D) تدعم الأرقام والحروف اللاتينية فقط. استخدم رمز QR للروابط والنصوص."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stregkoder (1D) understøtter kun tal og latinske bogstaver. Brug en QR-kode til links og tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strichcodes (1D) unterstützen nur Ziffern und lateinische Buchstaben. Für Links und Text einen QR-Code verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcodes (1D) only support numbers and Latin letters. Use a QR code for links and text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcodes (1D) only support numbers and Latin letters. Use a QR code for links and text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos de barras (1D) solo admiten números y letras latinas. Usa un QR para enlaces y texto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos de barras (1D) solo admiten números y letras latinas. Usa un QR para enlaces y texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viivakoodit (1D) tukevat vain numeroita ja latinalaisia kirjaimia. Käytä QR-koodia linkkeihin ja tekstiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes-barres (1D) n'acceptent que les chiffres et les lettres latines. Utilisez un QR pour les liens et le texte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes-barres (1D) n'acceptent que les chiffres et les lettres latines. Utilisez un QR pour les liens et le texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברקודים (1D) תומכים רק בספרות ובאותיות לטיניות. השתמש בקוד QR לקישורים ולטקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारकोड (1D) केवल अंक और लैटिन अक्षर स्वीकार करते हैं। लिंक और टेक्स्ट के लिए QR कोड इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode (1D) hanya mendukung angka dan huruf Latin. Gunakan kode QR untuk tautan dan teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici a barre (1D) supportano solo numeri e lettere latine. Usa un QR per link e testi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコード（1次元）は数字と半角英字のみ使えます。リンクや日本語のテキストにはQRコードを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바코드(1D)는 숫자와 라틴 문자만 지원합니다. 링크와 텍스트에는 QR 코드를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod bar (1D) hanya menyokong nombor dan huruf Latin. Gunakan kod QR untuk pautan dan teks."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Strekkoder (1D) støtter bare tall og latinske bokstaver. Bruk en QR-kode for lenker og tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streepjescodes (1D) ondersteunen alleen cijfers en Latijnse letters. Gebruik een QR-code voor links en tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kody kreskowe (1D) obsługują tylko cyfry i litery łacińskie. Do linków i tekstu użyj kodu QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Códigos de barras (1D) só aceitam números ou letras latinas. Para links e textos, use QR."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de barras (1D) só aceitam números e letras latinas. Use um QR para links e texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Штрихкоды (1D) поддерживают только цифры и латинские буквы. Для ссылок и текста используйте QR-код."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Streckkoder (1D) stöder bara siffror och latinska bokstäver. Använd en QR-kod för länkar och text."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บาร์โค้ด (1D) รองรับเฉพาะตัวเลขและตัวอักษรละติน ใช้ QR สำหรับลิงก์และข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkodlar (1D) yalnızca rakam ve Latin harflerini destekler. Bağlantı ve metin için QR kod kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Штрихкоди (1D) підтримують лише цифри та латинські літери. Для посилань і тексту використовуйте QR-код."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã vạch (1D) chỉ hỗ trợ chữ số và chữ Latinh. Dùng mã QR cho liên kết và văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形码（一维码）只支持数字或拉丁字母。链接和文字请用二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一維條碼只支援數字與拉丁字母，連結和文字請用 QR。"
          }
        }
      }
    },
