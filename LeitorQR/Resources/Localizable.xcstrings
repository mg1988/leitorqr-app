    "legal.privacy.sec5.body" : {
      "comment" : "Texto 5 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app contains no targeted advertising SDKs or third-party tracking platforms. Your browsing and usage remain strictly private."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリには、ターゲット広告用 SDK やサードパーティのトラッキングプラットフォームは組み込まれていません。お客様の閲覧・利用状況は厳重にプライベートに保たれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo não inclui SDKs de publicidade direcionada nem plataformas de monitoramento de terceiros. Sua navegação e uso permanecem estritamente privados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用内不嵌入任何第三方广告联盟 SDK 或跨平台行为追踪组件，为您提供纯净无干扰的使用环境。"
          }
        }
      }
    },
