            "value": "Esto no es contenido de un código Wi-Fi. Debe empezar con WIFI:."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole Wi-Fi-koodin sisältöä. Sen on alettava WIFI:."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas le contenu d'un code Wi-Fi. Il doit commencer par WIFI:."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas le contenu d'un code Wi-Fi. Il doit commencer par WIFI:."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא תוכן של קוד Wi-Fi. הוא צריך להתחיל ב-WIFI:."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Wi-Fi कोड की सामग्री नहीं है। इसे WIFI: से शुरू होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan isi kode Wi-Fi. Harus dimulai dengan WIFI:."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è il contenuto di un codice Wi-Fi. Deve iniziare con WIFI:."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiコードの内容ではありません（「WIFI:」で始まる必要があります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 코드 내용이 아닙니다. WIFI:로 시작해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan kandungan kod Wi-Fi. Ia mesti bermula dengan WIFI:."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke innhold fra en Wi-Fi-kode. Det må starte med WIFI:."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen wifi-code-inhoud. Deze moet beginnen met WIFI:."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest zawartość kodu Wi-Fi. Powinna zaczynać się od WIFI:."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não é o conteúdo de um código Wi-Fi (ele deve começar com WIFI:)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não é conteúdo de um código Wi-Fi. Deve começar por WIFI:."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не содержимое Wi-Fi-кода. Оно должно начинаться с WIFI:."
          }
        },
        "sv": {
