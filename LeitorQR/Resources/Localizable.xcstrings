          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non si connette automaticamente, inserisci questi dettagli in Impostazioni › Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
