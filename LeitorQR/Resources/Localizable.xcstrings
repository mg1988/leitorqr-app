    "security.privacy.note": {
      "comment": "Nota de privacidade da segurança",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل كافة الشيكات على جهازك. لا يتم تحميل أي روابط أو صور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kontroller kører på din enhed. Ingen links eller billeder uploades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Prüfungen laufen auf Ihrem Gerät. Es werden keine Links oder Bilder hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All checks run on your device. No links or images are uploaded."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All checks run on your device. No links or images are uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las comprobaciones se ejecutan en su dispositivo. No se suben enlaces ni imágenes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las comprobaciones se ejecutan en su dispositivo. No se suben enlaces ni imágenes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tarkistukset suoritetaan laitteellasi. Linkkejä tai kuvia ei ladata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les vérifications sont exécutées sur votre appareil. Aucun lien ou image n'est téléchargé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les vérifications sont effectuées sur votre appareil. Aucun lien ni image n'est téléchargé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הבדיקות פועלות במכשיר שלך. לא מועלים קישורים או תמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी जाँचें आपके डिवाइस पर चलती हैं. कोई लिंक या चित्र अपलोड नहीं किए गए हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pemeriksaan dijalankan di perangkat Anda. Tidak ada tautan atau gambar yang diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i controlli vengono eseguiti sul tuo dispositivo. Non vengono caricati collegamenti o immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックはすべてデバイス内で行われます。URLや画像がアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 검사는 귀하의 장치에서 실행됩니다. 링크나 이미지가 업로드되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua semakan dijalankan pada peranti anda. Tiada pautan atau imej dimuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sjekker kjører på enheten din. Ingen lenker eller bilder er lastet opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle controles worden op uw apparaat uitgevoerd. Er worden geen links of afbeeldingen geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie kontrole działają na Twoim urządzeniu. Żadne linki ani obrazy nie są przesyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as verificações são feitas no seu dispositivo. Nenhum link ou imagem é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as verificações são executadas no seu dispositivo. Nenhum link ou imagem é carregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все проверки выполняются на вашем устройстве. Никакие ссылки и изображения не загружаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kontroller körs på din enhet. Inga länkar eller bilder laddas upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบทั้งหมดทำงานบนอุปกรณ์ของคุณ ไม่มีการอัปโหลดลิงก์หรือรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kontroller cihazınızda gerçekleştirilir. Hiçbir bağlantı veya resim yüklenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі перевірки виконуються на вашому пристрої. Посилання чи зображення не завантажуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các bước kiểm tra đều chạy trên thiết bị của bạn. Không có liên kết hoặc hình ảnh được tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有核对都在本机完成，不会上传任何链接或图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有檢查都在您的設備上運行。沒有上傳連結或圖像。"
          }
        }
      }
    },
