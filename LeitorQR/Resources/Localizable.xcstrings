    "legal.terms.summary": {
      "comment": "Resumo dos termos",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتنزيل Leitor QR واستخدامه، فإنك توافق على هذه الشروط. تُقدَّم الخدمة للاستخدام الشخصي على منصة iOS من Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved at downloade og bruge Leitor QR accepterer du disse vilkår. Tjenesten er beregnet til personlig brug på Apples iOS-platform."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Herunterladen und Nutzen von Leitor QR akzeptierst du diese Bedingungen. Der Dienst ist für die persönliche Nutzung auf Apples iOS-Plattform bestimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By downloading and using Leitor QR, you agree to these terms. The service is provided for personal use on Apple's iOS platform."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "By downloading and using Leitor QR, you agree to these terms. The service is provided for personal use on Apple's iOS platform."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al descargar y usar Leitor QR, aceptas estos términos. El servicio se ofrece para uso personal en la plataforma iOS de Apple."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al descargar y usar Leitor QR, aceptas estos términos. El servicio se ofrece para uso personal en la plataforma iOS de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataamalla ja käyttämällä Leitor QR:ää hyväksyt nämä ehdot. Palvelu on tarkoitettu henkilökohtaiseen käyttöön Applen iOS-alustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En téléchargeant et en utilisant Leitor QR, vous acceptez ces conditions. Le service est fourni pour un usage personnel sur la plateforme iOS d'Apple."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En téléchargeant et en utilisant Leitor QR, vous acceptez ces conditions. Le service est fourni pour un usage personnel sur la plateforme iOS d'Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהורדה ובשימוש ב-Leitor QR, אתה מסכים לתנאים האלה. השירות מיועד לשימוש אישי בפלטפורמת iOS של Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR डाउनलोड और उपयोग करके आप इन शर्तों से सहमत होते हैं। सेवा Apple के iOS प्लेटफ़ॉर्म पर व्यक्तिगत उपयोग के लिए है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mengunduh dan menggunakan Leitor QR, Anda menyetujui ketentuan ini. Layanan disediakan untuk penggunaan pribadi di platform iOS Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricando e usando Leitor QR, accetti questi termini. Il servizio è fornito per uso personale sulla piattaforma iOS di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QRをダウンロードして使用することにより、お客様は本規約に同意したものとみなされます。本サービスは、iOSのエコシステム内での個人的な利用のために提供されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR를 다운로드하고 사용함으로써 귀하는 본 약관에 동의합니다. 서비스는 Apple의 iOS 플랫폼에서 개인적 사용을 위해 제공됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan memuat turun dan menggunakan Leitor QR, anda bersetuju dengan terma ini. Perkhidmatan disediakan untuk penggunaan peribadi pada platform iOS Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å laste ned og bruke Leitor QR godtar du disse vilkårene. Tjenesten er ment for personlig bruk på Apples iOS-plattform."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door Leitor QR te downloaden en gebruiken, ga je akkoord met deze voorwaarden. De dienst is bedoeld voor persoonlijk gebruik op Apple's iOS-platform."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierając i używając Leitor QR, akceptujesz te warunki. Usługa jest przeznaczona do użytku osobistego na platformie iOS firmy Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao baixar e usar o Leitor QR, você concorda com estes termos. O serviço é oferecido para uso pessoal dentro do ecossistema iOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao descarregar e usar o Leitor QR, aceita estes termos. O serviço é fornecido para uso pessoal na plataforma iOS da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружая и используя Leitor QR, вы принимаете эти условия. Сервис предназначен для личного использования на платформе Apple iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att ladda ner och använda Leitor QR godkänner du dessa villkor. Tjänsten tillhandahålls för personligt bruk på Apples iOS-plattform."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดาวน์โหลดและใช้ Leitor QR ถือว่าคุณยอมรับข้อกำหนดเหล่านี้ บริการนี้มีไว้สำหรับการใช้งานส่วนบุคคลบนแพลตฟอร์ม iOS ของ Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR'ı indirip kullanarak bu koşulları kabul etmiş olursunuz. Hizmet, Apple'ın iOS platformunda kişisel kullanım için sunulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажуючи й використовуючи Leitor QR, ви приймаєте ці умови. Сервіс призначено для особистого використання на платформі Apple iOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng việc tải xuống và sử dụng Leitor QR, bạn đồng ý với các điều khoản này. Dịch vụ được cung cấp cho mục đích cá nhân trên nền tảng iOS của Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并使用 Leitor QR，即表示你同意本条款。本服务供你在 iOS 生态中个人使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並使用 Leitor QR 即表示你同意本條款。本服務供個人在 Apple iOS 平台上使用。"
          }
        }
      }
    },
