    "legal.privacy.summary": {
      "comment": "Resumo da privacidade",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR أداة تركز على الخصوصية وتعمل بالكامل على جهازك. لا نجمع بياناتك الشخصية أو سجل رموزك ولا نتتبعها ولا نشاركها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR er et privatlivsfokuseret værktøj, der fungerer helt på din enhed. Vi indsamler, sporer eller deler ikke dine personlige oplysninger eller din historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR ist ein datenschutzorientiertes Tool, das vollständig auf deinem Gerät arbeitet. Wir sammeln, verfolgen oder teilen weder deine persönlichen Daten noch deinen Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR is a privacy-focused tool that works entirely on your device. We don't collect, track, or share your personal data or code history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR is a privacy-focused tool that works entirely on your device. We don't collect, track, or share your personal data or code history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR es una herramienta centrada en la privacidad que funciona íntegramente en tu dispositivo. No recopilamos, rastreamos ni compartimos tus datos personales ni tu historial."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR es una herramienta centrada en la privacidad que funciona íntegramente en tu dispositivo. No recopilamos, rastreamos ni compartimos tus datos personales ni tu historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR on yksityisyyteen keskittyvä työkalu, joka toimii kokonaan laitteellasi. Emme kerää, seuraa tai jaa henkilötietojasi tai historiaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR est un outil axé sur la confidentialité qui fonctionne entièrement sur votre appareil. Nous ne collectons, ne suivons ni ne partageons vos données personnelles ou votre historique."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR est un outil axé sur la confidentialité qui fonctionne entièrement sur votre appareil. Nous ne collectons, ne suivons ni ne partageons vos données personnelles ou votre historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR הוא כלי ממוקד פרטיות שפועל כולו במכשיר שלך. אנחנו לא אוספים, עוקבים או משתפים את הנתונים האישיים או היסטוריית הקודים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR गोपनीयता-केंद्रित टूल है जो पूरी तरह आपके डिवाइस पर काम करता है। हम आपका व्यक्तिगत डेटा या कोड इतिहास एकत्र, ट्रैक या साझा नहीं करते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR adalah alat yang berfokus pada privasi dan bekerja sepenuhnya di perangkat Anda. Kami tidak mengumpulkan, melacak, atau membagikan data pribadi atau riwayat kode Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR è uno strumento attento alla privacy che funziona interamente sul tuo dispositivo. Non raccogliamo, tracciamo né condividiamo i tuoi dati personali o la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QRは、すべての処理をデバイス内で行う、プライバシーを重視したツールです。お客様の個人データやコードの履歴を収集、追跡、共有することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR는 기기에서 완전히 작동하는 개인정보 보호 중심 도구입니다. 개인 데이터나 코드 기록을 수집, 추적 또는 공유하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR ialah alat berfokus privasi yang berfungsi sepenuhnya pada peranti anda. Kami tidak mengumpul, menjejak atau berkongsi data peribadi atau sejarah kod anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR er et personvernfokusert verktøy som fungerer helt på enheten din. Vi samler ikke inn, sporer eller deler personopplysningene dine eller historikken din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR is een privacygericht hulpmiddel dat volledig op je apparaat werkt. We verzamelen, volgen of delen je persoonsgegevens of geschiedenis niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR to narzędzie nastawione na prywatność, działające w całości na urządzeniu. Nie zbieramy, nie śledzimy ani nie udostępniamy Twoich danych osobowych ani historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor QR é uma ferramenta 100% local e focada em privacidade. Não coletamos, não rastreamos e não compartilhamos seus dados pessoais nem seu histórico de códigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor QR é uma ferramenta focada na privacidade que funciona inteiramente no seu dispositivo. Não recolhemos, rastreamos nem partilhamos os seus dados pessoais ou histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR — инструмент с упором на конфиденциальность, работающий полностью на вашем устройстве. Мы не собираем, не отслеживаем и не передаём ваши личные данные или историю."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR är ett integritetsfokuserat verktyg som fungerar helt på din enhet. Vi samlar inte in, spårar eller delar dina personuppgifter eller din historik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR เป็นเครื่องมือที่เน้นความเป็นส่วนตัวและทำงานบนอุปกรณ์ของคุณทั้งหมด เราไม่เก็บ ติดตาม หรือแชร์ข้อมูลส่วนตัวหรือประวัติโค้ดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR, tamamen cihazınızda çalışan gizlilik odaklı bir araçtır. Kişisel verilerinizi veya kod geçmişinizi toplamıyor, izlemiyor ya da paylaşmıyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR — інструмент з акцентом на конфіденційність, що працює повністю на вашому пристрої. Ми не збираємо, не відстежуємо й не передаємо ваші особисті дані чи історію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR là công cụ chú trọng quyền riêng tư, hoạt động hoàn toàn trên thiết bị của bạn. Chúng tôi không thu thập, theo dõi hay chia sẻ dữ liệu cá nhân hoặc lịch sử mã của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR 是一款完全在本地运行、注重隐私的工具。我们不会收集、追踪或分享你的个人数据和扫码历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR 是以隱私為核心、完全在你的裝置上運作的工具。我們不會收集、追蹤或分享你的個人資料或條碼記錄。"
          }
        }
      }
    },
