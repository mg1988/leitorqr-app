    "legal.terms.sec5.body": {
      "comment": "Texto 5 Termos",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقدَّم التطبيق «كما هو». لسنا مسؤولين عن محتوى مواقع الأطراف الثالثة أو أمانها أو دقتها، ولا عن المعلومات المشفّرة في الرموز التي تمسحها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen leveres »som den er«. Vi er ikke ansvarlige for indhold, sikkerhed eller nøjagtighed på tredjepartswebsteder eller oplysninger kodet i koder, du scanner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird „wie besehen“ bereitgestellt. Wir sind nicht verantwortlich für Inhalte, Sicherheit oder Richtigkeit von Websites Dritter oder von Informationen in Codes, die du scannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is provided “as is.” We are not responsible for the content, safety, or accuracy of third-party websites or of information encoded in codes you scan with the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is provided “as is.” We are not responsible for the content, safety, or accuracy of third-party websites or of information encoded in codes you scan with the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ofrece «tal cual». No somos responsables del contenido, la seguridad ni la exactitud de sitios de terceros ni de la información codificada en los códigos que escaneas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ofrece «tal cual». No somos responsables del contenido, la seguridad ni la exactitud de sitios de terceros ni de la información codificada en los códigos que escaneas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus tarjotaan sellaisenaan. Emme vastaa kolmannen osapuolen verkkosivujen tai skannaamiesi koodien sisältämien tietojen sisällöstä, turvallisuudesta tai oikeellisuudesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est fournie « en l'état ». Nous ne sommes pas responsables du contenu, de la sécurité ou de l'exactitude des sites tiers ni des informations encodées dans les codes que vous scannez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app est fournie « en l'état ». Nous ne sommes pas responsables du contenu, de la sécurité ou de l'exactitude des sites tiers ni des informations encodées dans les codes que vous scannez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה מסופקת ״כמות שהיא״. איננו אחראים לתוכן, לבטיחות או לדיוק של אתרי צד שלישי או של מידע המקודד בקודים שאתה סורק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप «जैसा है» प्रदान किया जाता है। हम तृतीय-पक्ष वेबसाइटों की सामग्री, सुरक्षा या सटीकता, या आपके द्वारा स्कैन किए गए कोड में एन्कोड की गई जानकारी के लिए ज़िम्मेदार नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi disediakan \"sebagaimana adanya\". Kami tidak bertanggung jawab atas isi, keamanan, atau ketepatan situs pihak ketiga atau informasi yang dikodekan dalam kode yang Anda pindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è fornita «così com'è». Non siamo responsabili del contenuto, della sicurezza o dell'accuratezza di siti di terzi né delle informazioni codificate nei codici che scansion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリは「現状のまま」提供されます。本アプリで読み取ったコードに含まれる第三者のWebサイトや情報について、その内容、安全性、正確性に当方は責任を負いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 \"있는 그대로\" 제공됩니다. 제3자 웹사이트나 스캔한 코드에 인코딩된 정보의 내용, 안전성 또는 정확성에 대해 책임지지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App disediakan “seadanya”. Kami tidak bertanggungjawab atas kandungan, keselamatan atau ketepatan laman pihak ketiga atau maklumat yang dikodkan dalam kod yang anda imbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen leveres «som den er». Vi er ikke ansvarlige for innhold, sikkerhet eller nøyaktighet på tredjepartsnettsteder eller informasjon kodet i koder du skanner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app wordt geleverd ‘zoals hij is’. We zijn niet verantwoordelijk voor de inhoud, veiligheid of juistheid van websites van derden of van informatie in codes die je scant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja jest udostępniana „tak jak jest”. Nie odpowiadamy za treść, bezpieczeństwo ani dokładność witryn podmiotów trzecich ani informacji zakodowanych w skanowanych kodach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app é fornecido “no estado em que se encontra”. Não nos responsabilizamos pelo conteúdo, pela segurança ou pela precisão de sites ou informações de terceiros contidos nos códigos que você lê com o app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor QR é fornecido «tal como está». Não somos responsáveis pelo conteúdo, segurança ou exatidão de sites de terceiros nem das informações codificadas nos códigos que lê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение предоставляется «как есть». Мы не отвечаем за содержание, безопасность и точность сторонних сайтов или информации, закодированной в сканируемых кодах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen tillhandahålls ”i befintligt skick”. Vi ansvarar inte för innehåll, säkerhet eller riktighet hos tredje parts webbplatser eller information kodad i koder du skannar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปให้บริการ \"ตามสภาพ\" เราไม่รับผิดชอบต่อเนื้อหา ความปลอดภัย หรือความถูกต้องของเว็บไซต์บุคคลที่สาม หรือข้อมูลที่เข้ารหัสในโค้ดที่คุณสแกน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama \"olduğu gibi\" sunulur. Üçüncü taraf web sitelerinin veya taradığınız kodlarda kodlanan bilgilerin içeriğinden, güvenliğinden veya doğruluğundan sorumlu değiliz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок надається «як є». Ми не відповідаємо за вміст, безпеку чи точність сторонніх сайтів або інформації, закодованої в сканованих кодах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng được cung cấp \"nguyên trạng\". Chúng tôi không chịu trách nhiệm về nội dung, an toàn hay tính chính xác của trang web bên thứ ba hoặc thông tin được mã hóa trong mã bạn quét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 按“现状”提供。对于你用本 App 扫描的码中所含的信息或第三方网站，我们不对其内容、安全性或准确性负责。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 依「現狀」提供。我們不對第三方網站，或你掃描的條碼中所編碼資訊的內容、安全性或準確性負責。"
          }
        }
      }
    },
