    "intent.connectWifi.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينضم إلى الشبكة في رمز واي فاي (نص يبدأ بـ WIFI:). استخدمه بعد إجراء «مسح رمز QR». يُرجع ما إذا تم الاتصال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opretter forbindelse til netværket i en Wi-Fi-kode (tekst, der starter med WIFI:). Brug efter »Scan QR-kode«. Angiver, om det lykkedes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet mit dem Netzwerk in einem WLAN-Code (Text, der mit WIFI: beginnt). Nach „QR-Code scannen“ verwenden. Gibt zurück, ob die Verbindung hergestellt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins the network in a Wi-Fi code (text that starts with WIFI:). Use it after the “Scan QR Code” action. Returns whether it joined."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins the network in a Wi-Fi code (text that starts with WIFI:). Use it after the “Scan QR Code” action. Returns whether it joined."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conecta a la red de un código Wi-Fi (texto que empieza por WIFI:). Úsalo después de «Escanear código QR». Indica si se conectó."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conecta a la red de un código Wi-Fi (texto que empieza con WIFI:). Úsalo después de «Escanear código QR». Indica si se conectó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistää Wi-Fi-koodin verkkoon (teksti, joka alkaa WIFI:). Käytä ”Skannaa QR-koodi” -toiminnon jälkeen. Kertoo, onnistuiko yhdistäminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoint le réseau d'un code Wi-Fi (texte commençant par WIFI:). À utiliser après « Scanner un code QR ». Indique si la connexion a réussi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoint le réseau d'un code Wi-Fi (texte commençant par WIFI:). À utiliser après « Scanner un code QR ». Indique si la connexion a réussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחבר לרשת בקוד Wi-Fi (טקסט שמתחיל ב-WIFI:). יש להשתמש אחרי הפעולה ״סרוק קוד QR״. מחזיר אם החיבור הצליח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi कोड में दिए नेटवर्क से जुड़ता है (WIFI: से शुरू होने वाला टेक्स्ट)। «QR कोड स्कैन करें» के बाद उपयोग करें। बताता है कि जुड़ा या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke jaringan dalam kode Wi-Fi (teks yang dimulai dengan WIFI:). Gunakan setelah tindakan “Pindai kode QR”. Mengembalikan apakah berhasil terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si connette alla rete di un codice Wi-Fi (testo che inizia con WIFI:). Usalo dopo «Scansiona codice QR». Indica se la connessione è riuscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiコードの内容（「WIFI:」で始まるテキスト）のネットワークに接続します。「QRコードをスキャン」アクションのあとに使います。接続できたかどうかを返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 코드의 네트워크에 연결합니다(WIFI:로 시작하는 텍스트). “QR 코드 스캔” 동작 후 사용하세요. 연결 여부를 반환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung ke rangkaian dalam kod Wi-Fi (teks yang bermula dengan WIFI:). Gunakan selepas tindakan “Imbas kod QR”. Memulangkan sama ada berjaya disambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kobler til nettverket i en Wi-Fi-kode (tekst som starter med WIFI:). Bruk etter «Skann QR-kode». Angir om tilkoblingen lykkedes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt verbinding met het netwerk in een wifi-code (tekst die begint met WIFI:). Gebruik na ‘QR-code scannen’. Geeft aan of de verbinding is gelukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączy z siecią z kodu Wi-Fi (tekst zaczynający się od WIFI:). Użyj po „Skanuj kod QR”. Zwraca informację, czy połączono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta à rede descrita em um código Wi-Fi (texto que começa com WIFI:). Use depois da ação “Ler código QR”. Retorna se a conexão deu certo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-se à rede de um código Wi-Fi (texto que começa por WIFI:). Use depois de «Ler código QR». Indica se a ligação foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключается к сети из Wi-Fi-кода (текст, начинающийся с WIFI:). Используйте после «Сканировать QR-код». Сообщает, удалось ли подключиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluter till nätverket i en Wi-Fi-kod (text som börjar med WIFI:). Använd efter ”Skanna QR-kod”. Anger om anslutningen lyckades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อเครือข่ายในโค้ด Wi-Fi (ข้อความที่ขึ้นต้นด้วย WIFI:) ใช้หลังการกระทำ “สแกน QR โค้ด” และคืนค่าว่าเชื่อมต่อสำเร็จหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi kodundaki ağa bağlanır (WIFI: ile başlayan metin). \"QR kod tara\" işleminden sonra kullanın. Bağlanıp bağlanmadığını döndürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключається до мережі з Wi-Fi-коду (текст, що починається з WIFI:). Використовуйте після «Сканувати QR-код». Повідомляє, чи вдалося підключитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối với mạng trong mã Wi-Fi (văn bản bắt đầu bằng WIFI:). Dùng sau thao tác “Quét mã QR”. Trả về việc đã kết nối hay chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 Wi-Fi 码的内容（以 WIFI: 开头的文本）并加入对应网络。可以接在“扫描二维码”操作之后使用。返回是否连接成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接 Wi-Fi 條碼中的網路（以 WIFI: 開頭的文字）。請在「掃描 QR 碼」動作之後使用，並回傳是否連接成功。"
          }
        }
      }
    },
    "intent.connectWifi.notWifi": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس محتوى رمز واي فاي. يجب أن يبدأ بـ WIFI:."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke indhold fra en Wi-Fi-kode. Det skal starte med WIFI:."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein WLAN-Code-Inhalt. Er muss mit WIFI: beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn’t Wi-Fi code content. It should start with WIFI:."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn’t Wi-Fi code content. It should start with WIFI:."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es contenido de un código Wi-Fi. Debe empezar por WIFI:."
          }
        },
        "es-419": {
          "stringUnit": {
