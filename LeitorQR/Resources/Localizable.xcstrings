        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Verbindung nicht automatisch hergestellt wird, geben Sie diese Details unter Einstellungen › WLAN ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it doesn't connect automatically, enter these details in Settings › Wi-Fi."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If it doesn't connect automatically, enter these details in Settings › Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se conecta automáticamente, ingrese estos detalles en Configuración › Wi-Fi."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se conecta automáticamente, ingrese estos detalles en Configuración › Wi-Fi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos se ei muodosta yhteyttä automaattisesti, anna nämä tiedot kohtaan Asetukset › Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
