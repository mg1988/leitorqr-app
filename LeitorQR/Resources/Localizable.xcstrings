    "legal.terms.sec3.body": {
      "comment": "Corpo seção 3 dos termos",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استعادة عمليات الشراء السابقة في أي وقت بزر «استعادة المشتريات» في شاشة Premium. تُعالج عمليات الاسترداد بواسطة Apple فقط؛ يمكنك طلبها على reportaproblem.apple.com أو من سجل مشترياتك في App Store."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gendanne tidligere køb når som helst med knappen Gendan køb på Premium-skærmen. Refusioner håndteres udelukkende af Apple; anmod om en på reportaproblem.apple.com eller i din købshistorik i App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst frühere Käufe jederzeit über „Käufe wiederherstellen“ auf dem Premium-Bildschirm wiederherstellen. Rückerstattungen erfolgen ausschließlich durch Apple; beantrage sie auf reportaproblem.apple.com oder im App-Store-Kaufverlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore previous purchases at any time with the Restore Purchases button on the Premium screen. Refunds are handled solely by Apple; you can request one at reportaproblem.apple.com or from your App Store purchase history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore previous purchases at any time with the Restore Purchases button on the Premium screen. Refunds are handled solely by Apple; you can request one at reportaproblem.apple.com or from your App Store purchase history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurar compras anteriores cuando quieras con el botón Restaurar compras en la pantalla Premium. Los reembolsos los gestiona solo Apple; puedes solicitarlos en reportaproblem.apple.com o desde tu historial de compras del App Store."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurar compras anteriores cuando quieras con el botón Restaurar compras en la pantalla Premium. Los reembolsos los gestiona solo Apple; puedes solicitarlos en reportaproblem.apple.com o desde tu historial de compras del App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit palauttaa aiemmat ostot milloin tahansa Premium-näytön Palauta ostot -painikkeella. Hyvitykset hoitaa vain Apple; voit pyytää sitä osoitteessa reportaproblem.apple.com tai App Storen ostohistoriasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez restaurer vos achats à tout moment avec le bouton Restaurer les achats sur l'écran Premium. Les remboursements sont gérés uniquement par Apple ; demandez-en un sur reportaproblem.apple.com ou dans l'historique d'achats de l'App Store."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez restaurer vos achats à tout moment avec le bouton Restaurer les achats sur l'écran Premium. Les remboursements sont gérés uniquement par Apple ; demandez-en un sur reportaproblem.apple.com ou dans l'historique d'achats de l'App Store."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשחזר רכישות קודמות בכל עת באמצעות הכפתור ״שחזר רכישות״ במסך Premium. החזרים מטופלים על ידי Apple בלבד; אפשר לבקש החזר ב-reportaproblem.apple.com או בהיסטוריית הרכישות ב-App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Premium स्क्रीन पर «खरीदारी पुनर्स्थापित करें» बटन से कभी भी पिछली खरीदारी पुनर्स्थापित कर सकते हैं। रिफंड केवल Apple द्वारा संभाले जाते हैं; आप reportaproblem.apple.com पर या App Store खरीद इतिहास से अनुरोध कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat memulihkan pembelian sebelumnya kapan saja dengan tombol Pulihkan Pembelian di layar Premium. Pengembalian dana hanya ditangani Apple; Anda dapat memintanya di reportaproblem.apple.com atau dari riwayat pembelian App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ripristinare gli acquisti precedenti in qualsiasi momento con il pulsante Ripristina acquisti nella schermata Premium. I rimborsi sono gestiti solo da Apple; puoi richiederli su reportaproblem.apple.com o dalla cronologia acquisti dell'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の購入は、「購入状況」画面の「購入を復元」ボタンからいつでも復元できます。返金はAppleのみが取り扱います。reportaproblem.apple.comまたはApp Storeの購入履歴から申請してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 구매는 Premium 화면의 '구매 복원' 버튼으로 언제든 복원할 수 있습니다. 환불은 Apple이 전담하며, reportaproblem.apple.com 또는 App Store 구매 내역에서 요청할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memulihkan pembelian terdahulu pada bila-bila masa dengan butang Pulihkan Pembelian pada skrin Premium. Bayaran balik hanya dikendalikan oleh Apple; anda boleh memohon di reportaproblem.apple.com atau daripada sejarah pembelian App Store."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gjenopprette tidligere kjøp når som helst med knappen Gjenopprett kjøp på Premium-skjermen. Refusjoner håndteres kun av Apple; be om en på reportaproblem.apple.com eller i kjøpshistorikken i App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt eerdere aankopen altijd herstellen met de knop Aankopen herstellen op het Premium-scherm. Terugbetalingen worden uitsluitend door Apple afgehandeld; vraag ze aan op reportaproblem.apple.com of via je App Store-aankoopgeschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz w każdej chwili przywrócić wcześniejsze zakupy przyciskiem Przywróć zakupy na ekranie Premium. Zwroty obsługuje wyłącznie Apple; możesz o nie poprosić na reportaproblem.apple.com lub w historii zakupów App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurar compras anteriores a qualquer momento com o botão “Restaurar Compras” na tela Seu plano. Os reembolsos são tratados exclusivamente pela Apple; solicite em reportaproblem.apple.com ou pelo seu histórico de compras da App Store."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode restaurar compras anteriores a qualquer momento com o botão Restaurar compras no ecrã Premium. Os reembolsos são tratados apenas pela Apple; pode pedi-los em reportaproblem.apple.com ou no histórico de compras da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете восстановить прежние покупки в любой момент кнопкой «Восстановить покупки» на экране Premium. Возвраты выполняет только Apple; запросить их можно на reportaproblem.apple.com или в истории покупок App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan återställa tidigare köp när som helst med knappen Återställ köp på Premium-skärmen. Återbetalningar hanteras enbart av Apple; begär en på reportaproblem.apple.com eller i din köphistorik i App Store."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถกู้คืนการซื้อก่อนหน้าได้ทุกเมื่อด้วยปุ่มกู้คืนการซื้อบนหน้าจอ Premium การคืนเงินดำเนินการโดย Apple เท่านั้น คุณสามารถขอได้ที่ reportaproblem.apple.com หรือจากประวัติการซื้อใน App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki satın almalarınızı Premium ekranındaki Satın Alımları Geri Yükle düğmesiyle istediğiniz zaman geri yükleyebilirsiniz. İadeler yalnızca Apple tarafından işlenir; reportaproblem.apple.com adresinden veya App Store satın alma geçmişinizden talep edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете відновити попередні покупки будь-коли кнопкою «Відновити покупки» на екрані Premium. Повернення виконує лише Apple; запросити його можна на reportaproblem.apple.com або в історії покупок App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể khôi phục giao dịch trước bất cứ lúc nào bằng nút Khôi phục mua hàng trên màn hình Premium. Hoàn tiền do Apple xử lý duy nhất; bạn có thể yêu cầu tại reportaproblem.apple.com hoặc từ lịch sử mua hàng trên App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在“我的购买”页面轻点“恢复购买”，恢复以前的购买项目。退款仅由 Apple 处理，请前往 reportaproblem.apple.com 或在 App Store 购买记录中申请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可隨時在 Premium 畫面點「恢復購買」找回先前的購買。退款僅由 Apple 處理，可在 reportaproblem.apple.com 或 App Store 購買記錄中提出申請。"
          }
        }
      }
    },
