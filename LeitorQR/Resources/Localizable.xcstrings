    "legal.terms.sec1.body": {
      "comment": "Texto 1 Termos",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نمنحك ترخيصًا شخصيًا غير حصري وغير قابل للتحويل وقابلًا للإلغاء لتثبيت Leitor QR واستخدامه على أجهزة Apple المرتبطة بحسابك الشخصي، وفقًا لقواعد استخدام App Store."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi giver dig en personlig, ikke-eksklusiv, ikke-overdragelig og tilbagekaldelig licens til at installere og bruge Leitor QR på Apple-enheder knyttet til din personlige konto, i overensstemmelse med App Stores brugsregler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir gewähren dir eine persönliche, nicht exklusive, nicht übertragbare und widerrufliche Lizenz zur Installation und Nutzung von Leitor QR auf Apple-Geräten deines persönlichen Accounts gemäß den App-Store-Nutzungsregeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We grant you a personal, non-exclusive, non-transferable, revocable license to install and use Leitor QR on Apple devices associated with your personal account, in accordance with the App Store Usage Rules."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We grant you a personal, non-exclusive, non-transferable, revocable license to install and use Leitor QR on Apple devices associated with your personal account, in accordance with the App Store Usage Rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te concedemos una licencia personal, no exclusiva, intransferible y revocable para instalar y usar Leitor QR en dispositivos Apple asociados a tu cuenta personal, conforme a las normas de uso del App Store."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Te concedemos una licencia personal, no exclusiva, intransferible y revocable para instalar y usar Leitor QR en dispositivos Apple asociados a tu cuenta personal, conforme a las normas de uso del App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myönnämme sinulle henkilökohtaisen, ei-yksinomaisen, siirtokelvottoman ja peruutettavan lisenssin asentaa ja käyttää Leitor QR:ää henkilökohtaiseen tiliisi liitetyillä Apple-laitteilla App Storen käyttösääntöjen mukaisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous accordons une licence personnelle, non exclusive, non transférable et révocable pour installer et utiliser Leitor QR sur les appareils Apple associés à votre compte personnel, conformément aux règles d'utilisation de l'App Store."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous accordons une licence personnelle, non exclusive, non transférable et révocable pour installer et utiliser Leitor QR sur les appareils Apple associés à votre compte personnel, conformément aux règles d'utilisation de l'App Store."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנו מעניקים לך רישיון אישי, לא בלעדי, לא ניתן להעברה וניתן לביטול, להתקין ולהשתמש ב-Leitor QR במכשירי Apple המשויכים לחשבון האישי שלך, בהתאם לכללי השימוש של App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको अपने व्यक्तिगत खाते से जुड़े Apple उपकरणों पर App Store उपयोग नियमों के अनुसार Leitor QR इंस्टॉल और उपयोग करने का व्यक्तिगत, गैर-अनन्य, अहस्तांतरणीय और रद्द करने योग्य लाइसेंस देते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memberi Anda lisensi pribadi, non-eksklusif, tidak dapat dialihkan, dan dapat dicabut untuk memasang dan menggunakan Leitor QR di perangkat Apple yang terkait dengan akun pribadi Anda, sesuai Aturan Penggunaan App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti concediamo una licenza personale, non esclusiva, non trasferibile e revocabile per installare e usare Leitor QR su dispositivi Apple associati al tuo account personale, secondo le regole d'uso dell'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当方はお客様に対し、App Storeの利用規則に従い、お客様の個人アカウントに関連付けられたAppleデバイス上でLeitor QRをインストールおよび使用するための、個人的、非独占的、譲渡不能かつ取消可能なライセンスを付与します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당사는 App Store 사용 규칙에 따라 귀하의 개인 계정과 연결된 Apple 기기에 Leitor QR를 설치하고 사용할 수 있는 개인적, 비독점적, 양도 불가, 철회 가능한 라이선스를 부여합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memberi anda lesen peribadi, bukan eksklusif, tidak boleh dipindah milik dan boleh dibatalkan untuk memasang dan menggunakan Leitor QR pada peranti Apple yang dikaitkan dengan akaun peribadi anda, menurut Peraturan Penggunaan App Store."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi gir deg en personlig, ikke-eksklusiv, ikke-overførbar og tilbakekallelig lisens til å installere og bruke Leitor QR på Apple-enheter knyttet til din personlige konto, i samsvar med App Stores bruksregler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We verlenen je een persoonlijke, niet-exclusieve, niet-overdraagbare en herroepbare licentie om Leitor QR te installeren en gebruiken op Apple-apparaten die aan je persoonlijke account zijn gekoppeld, volgens de gebruiksvoorwaarden van de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udzielamy Ci osobistej, niewyłącznej, niezbywalnej i odwoływalnej licencji na instalowanie i używanie Leitor QR na urządzeniach Apple powiązanych z Twoim kontem osobistym, zgodnie z zasadami korzystania z App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedemos a você uma licença pessoal, não exclusiva, intransferível e revogável para instalar e usar o Leitor QR em dispositivos Apple associados à sua conta pessoal, de acordo com as regras de uso da App Store."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedemos-lhe uma licença pessoal, não exclusiva, intransmissível e revogável para instalar e usar o Leitor QR em dispositivos Apple associados à sua conta pessoal, nos termos das regras de utilização da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы предоставляем вам личную, неисключительную, непередаваемую и отзываемую лицензию на установку и использование Leitor QR на устройствах Apple, связанных с вашей личной учётной записью, в соответствии с правилами App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ger dig en personlig, icke-exklusiv, icke-överlåtbar och återkallelig licens att installera och använda Leitor QR på Apple-enheter kopplade till ditt personliga konto, i enlighet med App Stores användningsregler."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราให้สิทธิ์การใช้งานแบบส่วนบุคคล ไม่ผูกขาด โอนไม่ได้ และเพิกถอนได้แก่คุณ ในการติดตั้งและใช้ Leitor QR บนอุปกรณ์ Apple ที่เชื่อมกับบัญชีส่วนตัวของคุณ ตามกฎการใช้งาน App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR'ı kişisel hesabınıza bağlı Apple cihazlarında App Store Kullanım Kuralları'na uygun olarak kurmanız ve kullanmanız için kişisel, münhasır olmayan, devredilemez ve geri alınabilir bir lisans veriyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми надаємо вам особисту, невиключну, непередавану й відкличну ліцензію на встановлення та використання Leitor QR на пристроях Apple, пов'язаних з вашим особистим обліковим записом, згідно з правилами App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi cấp cho bạn giấy phép cá nhân, không độc quyền, không chuyển nhượng và có thể thu hồi để cài đặt và sử dụng Leitor QR trên các thiết bị Apple liên kết với tài khoản cá nhân của bạn, theo Quy tắc sử dụng App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们授予你一项个人的、非独占的、不可转让且可撤销的许可，允许你依照 App Store 使用规则，在与你个人账户关联的 Apple 设备上安装和使用 Leitor QR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們授予你個人、非專屬、不可轉讓且可撤銷的授權，讓你依 App Store 使用規則，在自己的個人帳號所連結的 Apple 裝置上安裝及使用 Leitor QR。"
          }
        }
      }
    },
