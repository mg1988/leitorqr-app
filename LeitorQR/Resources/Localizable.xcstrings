          "stringUnit": {
            "state": "translated",
            "value": "Tämä merkintä poistetaan. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette entrée sera supprimée. Action irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
