          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não se ligar automaticamente, introduza estes detalhes em Definições › Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
