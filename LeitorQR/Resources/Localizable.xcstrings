    "settings.auto.footer": {
      "comment": "Desativado por padrão. Endereços suspeitos nunca são abertos automaticamente, e contactos ou eventos nunca são guardados sem confirmação.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف بشكل افتراضي. لا يتم فتح الروابط المشبوهة تلقائيًا أبدًا، ولا يتم حفظ جهات الاتصال أو الأحداث بدون تأكيد منك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra som standard. Mistænkelige links åbner aldrig automatisk, og kontakter eller begivenheder gemmes aldrig uden din bekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. Verdächtige Links werden niemals automatisch geöffnet und Kontakte oder Ereignisse werden niemals ohne Ihre Bestätigung gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Suspicious links never open automatically, and contacts or events are never saved without your confirmation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Suspicious links never open automatically, and contacts or events are never saved without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. Los enlaces sospechosos nunca se abren automáticamente y los contactos o eventos nunca se guardan sin su confirmación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. Los enlaces sospechosos nunca se abren automáticamente y los contactos o eventos nunca se guardan sin su confirmación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuksena pois päältä. Epäilyttävät linkit eivät koskaan avaudu automaattisesti, eikä yhteystietoja tai tapahtumia tallenneta koskaan ilman vahvistusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les liens suspects ne s'ouvrent jamais automatiquement et les contacts ou événements ne sont jamais enregistrés sans votre confirmation."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les liens suspects ne s'ouvrent jamais automatiquement et les contacts ou événements ne sont jamais enregistrés sans votre confirmation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי כברירת מחדל. קישורים חשודים לעולם אינם נפתחים אוטומטית, ואנשי קשר או אירועים לעולם אינם נשמרים ללא אישורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बंद. संदिग्ध लिंक कभी भी स्वचालित रूप से नहीं खुलते हैं, और संपर्क या ईवेंट आपकी पुष्टि के बिना कभी भी सहेजे नहीं जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati secara default. Tautan mencurigakan tidak pernah terbuka secara otomatis, dan kontak atau acara tidak pernah disimpan tanpa konfirmasi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato per impostazione predefinita. I collegamenti sospetti non si aprono mai automaticamente e i contatti o gli eventi non vengono mai salvati senza la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではオフです。疑わしいリンクが自動で開くことはなく、連絡先や予定も確認なしに保存されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 의심스러운 링크는 자동으로 열리지 않으며, 귀하의 확인 없이는 연락처나 이벤트가 저장되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati secara lalai. Pautan yang mencurigakan tidak pernah dibuka secara automatik dan kenalan atau acara tidak akan disimpan tanpa pengesahan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av som standard. Mistenkelige lenker åpnes aldri automatisk, og kontakter eller hendelser blir aldri lagret uten din bekreftelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard uitgeschakeld. Verdachte links worden nooit automatisch geopend en contacten of evenementen worden nooit opgeslagen zonder uw bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wyłączone. Podejrzane linki nigdy nie otwierają się automatycznie, a kontakty i wydarzenia nigdy nie są zapisywane bez Twojego potwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Links suspeitos nunca são abertos automaticamente, e contatos ou eventos nunca são salvos sem a sua confirmação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por defeito. Os links suspeitos nunca abrem automaticamente e os contactos ou eventos nunca são guardados sem a sua confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Подозрительные ссылки никогда не открываются автоматически, а контакты или события никогда не сохраняются без вашего подтверждения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av som standard. Misstänkta länkar öppnas aldrig automatiskt och kontakter eller händelser sparas aldrig utan din bekräftelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดโดยค่าเริ่มต้น ลิงก์ที่น่าสงสัยจะไม่เปิดโดยอัตโนมัติ และผู้ติดต่อหรือเหตุการณ์จะไม่ถูกบันทึกหากไม่มีการยืนยันจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalıdır. Şüpheli bağlantılar asla otomatik olarak açılmaz ve kişiler veya etkinlikler onayınız olmadan asla kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням вимкнено. Підозрілі посилання ніколи не відкриваються автоматично, а контакти чи події ніколи не зберігаються без вашого підтвердження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định. Các liên kết đáng ngờ không bao giờ tự động mở và các liên hệ hoặc sự kiện không bao giờ được lưu nếu không có xác nhận của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。可疑链接永远不会自动打开；联系人和日程也不会在你确认前存入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。可疑連結絕不會自動打開，且未經您的確認絕不會儲存聯絡人或事件。"
          }
        }
      }
    },
