    "subscription.info.cancel" : {
      "comment" : "Como cancelar",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can cancel auto-renewal through Apple. After canceling, you'll keep access to Premium features until the end of the paid period."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple を通じて自動更新をキャンセルできます。キャンセル後も、支払い済みの期間が終了するまで Premium 機能をご利用いただけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode cancelar a renovação automática por meio da Apple. Depois de cancelar, continuará tendo acesso às funcionalidades Premium até o fim do período já pago."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以通过 Apple 取消自动续订。取消后，仍可使用 Premium 功能，直到当前付费周期结束。"
          }
        }
      }
    },
    "subscription.info.refund" : {
      "comment" : "Como pedir reembolso",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To request a refund, contact Apple through its official support channels. Canceling renewal is not the same as requesting a refund."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "払い戻しをご希望の場合は、Apple 公式サポート窓口までお問い合わせください。更新のキャンセルは払い戻しの申請にはあたりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para pedir um reembolso, entre em contato com a Apple pelos canais oficiais de suporte. Cancelar a renovação não equivale a um pedido de reembolso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需退款，请通过 Apple 官方支持渠道申请。取消续订不等同于退款申请。"
          }
        }
      }
    },
