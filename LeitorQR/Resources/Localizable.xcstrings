        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sekali untuk setiap gaya, riwayat tak terbatas, dan logo Anda sendiri. Dasar-dasarnya tetap gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una volta per ogni stile, cronologia illimitata e il tuo logo. Le basi rimangono gratuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、すべてのスタイル、無制限の履歴、オリジナルのロゴが使えます。基本機能はずっと無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스타일, 무제한 기록, 나만의 로고에 대해 한 번만 지불하세요. 기본은 무료로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sekali untuk setiap gaya, sejarah tanpa had dan logo anda sendiri. Perkara asas kekal percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal én gang for hver stil, ubegrenset historie og din egen logo. Det grunnleggende forblir gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal één keer voor elke stijl, onbeperkte geschiedenis en uw eigen logo. De basis blijft gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapłać raz za każdy styl, nieograniczoną historię i własne logo. Podstawy pozostają bezpłatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez e desbloqueie todos os estilos, o histórico ilimitado e seu próprio logo. O básico continua grátis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez por cada estilo, histórico ilimitado e o seu próprio logótipo. O básico continua a ser gratuito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платите один раз за каждый стиль, неограниченную историю и собственный логотип. Базовые возможности остаются бесплатными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betala en gång för varje stil, obegränsad historia och din egen logotyp. Grunderna förblir gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จ่ายครั้งเดียวสำหรับทุกสไตล์ ประวัติไม่จำกัด และโลโก้ของคุณเอง พื้นฐานอยู่ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her stil, sınırsız geçmiş ve kendi logonuz için bir kez ödeme yapın. Temel bilgiler ücretsiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіть один раз за кожен стиль, необмежену історію та власний логотип. Основи залишаються безкоштовними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán một lần cho mọi phong cách, lịch sử không giới hạn và logo của riêng bạn. Những điều cơ bản vẫn miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部样式、无限历史、自定义 Logo，一次购买，永久使用。基础功能一直免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每種風格、無限的歷史記錄和您自己的徽標支付一次費用。基本功能保持免費。"
          }
        }
      }
    },
