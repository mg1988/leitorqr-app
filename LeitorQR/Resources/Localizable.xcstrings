          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout l'historique des chèques sera supprimé de cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל היסטוריית הבדיקות תוסר מהמכשיר הזה."
