        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定ではオフです。疑わしいリンクは自動で開かず、連絡先や予定も確認なしに保存されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
