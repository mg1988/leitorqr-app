          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 연결되지 않으면 설정 › Wi-Fi에 세부정보를 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
