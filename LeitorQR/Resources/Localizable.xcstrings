    "result.payment.note": {
      "comment": "O iOS não inicia transferências SEPA. Use estes dados na app do seu banco.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع iOS بدء عمليات نقل SEPA. استخدم هذه التفاصيل في تطبيقك المصرفي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kan ikke starte SEPA-overførsler. Brug disse oplysninger i din bankapp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kann keine SEPA-Überweisungen starten. Verwenden Sie diese Angaben in Ihrer Banking-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS can't start SEPA transfers. Use these details in your banking app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS can't start SEPA transfers. Use these details in your banking app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no puede iniciar transferencias SEPA. Utilice estos datos en su aplicación bancaria."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no puede iniciar transferencias SEPA. Utilice estos datos en su aplicación bancaria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ei voi aloittaa SEPA-siirtoja. Käytä näitä tietoja pankkisovelluksessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne peut pas démarrer les virements SEPA. Utilisez ces informations dans votre application bancaire."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne peut pas démarrer les virements SEPA. Utilisez ces renseignements dans votre application bancaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא יכול להתחיל העברות SEPA. השתמש בפרטים אלה באפליקציית הבנקאות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS SEPA स्थानांतरण प्रारंभ नहीं कर सकता. अपने बैंकिंग ऐप में इन विवरणों का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tidak dapat memulai transfer SEPA. Gunakan detail ini di aplikasi perbankan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non può avviare trasferimenti SEPA. Utilizza questi dettagli nella tua app bancaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSではSEPA送金を開始できません。この情報を銀行のアプリで入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 SEPA 전송을 시작할 수 없습니다. 뱅킹 앱에서 이러한 세부정보를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS tidak boleh memulakan pemindahan SEPA. Gunakan butiran ini dalam apl perbankan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kan ikke starte SEPA-overføringer. Bruk disse detaljene i bankappen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kan SEPA-overdrachten niet starten. Gebruik deze gegevens in uw bankierenapp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS nie może rozpocząć przelewów SEPA. Użyj tych danych w swojej aplikacji bankowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não inicia transferências SEPA. Use estes dados no app do seu banco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não consegue iniciar transferências SEPA. Utilize estes detalhes no seu aplicativo bancário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не может начать передачу SEPA. Используйте эти данные в своем банковском приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS kan inte starta SEPA-överföringar. Använd dessa uppgifter i din bankapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ไม่สามารถเริ่มการถ่ายโอน SEPA ได้ ใช้รายละเอียดเหล่านี้ในแอปธนาคารของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS SEPA aktarımlarını başlatamıyor. Bu ayrıntıları bankacılık uygulamanızda kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не може розпочати перекази SEPA. Використовуйте ці дані у своєму банківському додатку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không thể bắt đầu chuyển SEPA. Sử dụng những chi tiết này trong ứng dụng ngân hàng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法直接发起 SEPA 转账，请在银行 App 中使用以上信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法啟動 SEPA 傳輸。在您的銀行應用程式中使用這些詳細資訊。"
          }
        }
      }
    },
