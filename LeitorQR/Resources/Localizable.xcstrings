    "legal.contact.desc": {
      "comment": "Descrição do contacto",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للأسئلة القانونية أو المتعلقة بالخصوصية أو الدعم، راسلنا على genweimi@gmail.com."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved juridiske spørgsmål, privatliv eller support, skriv til genweimi@gmail.com."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei rechtlichen Fragen, Datenschutz- oder Support-Anliegen schreib an genweimi@gmail.com."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For legal, privacy, or support questions, email us at genweimi@gmail.com."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For legal, privacy, or support questions, email us at genweimi@gmail.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para consultas legales, de privacidad o soporte, escríbenos a genweimi@gmail.com."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para consultas legales, de privacidad o soporte, escríbenos a genweimi@gmail.com."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeudellisissa, tietosuoja- tai tukikysymyksissä lähetä sähköpostia osoitteeseen genweimi@gmail.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question juridique, de confidentialité ou d'assistance, écrivez-nous à genweimi@gmail.com."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toute question juridique, de confidentialité ou d'assistance, écrivez-nous à genweimi@gmail.com."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשאלות משפטיות, פרטיות או תמיכה, כתוב לנו ל-genweimi@gmail.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कानूनी, गोपनीयता या सहायता संबंधी प्रश्नों के लिए genweimi@gmail.com पर ईमेल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pertanyaan hukum, privasi, atau dukungan, kirim email ke genweimi@gmail.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per domande legali, sulla privacy o di assistenza, scrivi a genweimi@gmail.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法的事項、プライバシー、サポートに関するご質問は、genweimi@gmail.comまでお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법률, 개인정보 또는 지원 관련 문의는 genweimi@gmail.com으로 이메일을 보내주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pertanyaan undang-undang, privasi atau sokongan, e-mel kami di genweimi@gmail.com."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For juridiske spørsmål, personvern eller støtte, send e-post til genweimi@gmail.com."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor juridische, privacy- of supportvragen mail je naar genweimi@gmail.com."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sprawach prawnych, prywatności lub pomocy napisz na genweimi@gmail.com."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dúvidas jurídicas, de privacidade ou de suporte, fale com a gente em genweimi@gmail.com."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para questões legais, de privacidade ou de suporte, escreva para genweimi@gmail.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По юридическим вопросам, вопросам конфиденциальности и поддержки пишите на genweimi@gmail.com."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För juridiska frågor, integritets- eller supportfrågor, mejla genweimi@gmail.com."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับคำถามด้านกฎหมาย ความเป็นส่วนตัว หรือการสนับสนุน อีเมลถึงเราที่ genweimi@gmail.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hukuki, gizlilik veya destek soruları için genweimi@gmail.com adresine e-posta gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З юридичних питань, питань конфіденційності та підтримки пишіть на genweimi@gmail.com."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với câu hỏi pháp lý, quyền riêng tư hoặc hỗ trợ, hãy gửi email đến genweimi@gmail.com."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有法律、隐私或使用方面的问题，请发邮件至 genweimi@gmail.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有法律、隱私或支援問題，請寄電子郵件至 genweimi@gmail.com。"
          }
        }
      }
    },
