    "onboarding.camera.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ذلك، سنطلب الوصول إلى الكاميرا. يُستخدم فقط لقراءة الرموز في الوقت الفعلي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter beder vi om kameraadgang. Det bruges kun til at læse koder i realtid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes fragen wir nach dem Kamerazugriff. Er dient nur zum Lesen von Codes in Echtzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, we’ll ask for camera access. It’s only used to read codes in real time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, we’ll ask for camera access. It’s only used to read codes in real time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después te pediremos acceso a la cámara. Solo se usa para leer códigos en tiempo real."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Después te pediremos acceso a la cámara. Solo se usa para leer códigos en tiempo real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavaksi pyydämme kamera käyttöoikeutta. Sitä käytetään vain koodien lukemiseen reaaliajassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, nous demanderons l'accès à la caméra. Il sert uniquement à lire les codes en temps réel."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, nous demanderons l'accès à la caméra. Il sert uniquement à lire les codes en temps réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר מכן נבקש גישה למצלמה. היא משמשת רק לקריאת קודים בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद हम कैमरा एक्सेस माँगेंगे। यह केवल रीयल-टाइम में कोड पढ़ने के लिए उपयोग होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selanjutnya, kami akan meminta akses kamera. Hanya dipakai untuk membaca kode secara real-time."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi chiederemo l'accesso alla fotocamera. Serve solo a leggere i codici in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあとカメラへのアクセスを求めます。コードをリアルタイムで読み取るためだけに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 카메라 접근 권한을 요청합니다. 이 권한은 코드를 실시간으로 읽는 데만 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seterusnya, kami akan meminta akses kamera. Ia hanya digunakan untuk membaca kod secara masa nyata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter ber vi om kameratilgang. Den brukes bare til å lese koder i sanntid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervolgens vragen we om toegang tot de camera. Die wordt alleen gebruikt om codes in realtime te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie poprosimy o dostęp do kamery. Służy ona tylko do odczytu kodów w czasie rzeczywistym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, vamos pedir acesso à câmera, usada só para ler códigos em tempo real."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir, pediremos acesso à câmara. Só é usado para ler códigos em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее мы запросим доступ к камере. Он нужен только для чтения кодов в реальном времени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan ber vi om kameraåtkomst. Den används bara för att läsa koder i realtid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากนั้นเราจะขอสิทธิ์เข้าถึงกล้อง ใช้เพื่ออ่านโค้ดแบบเรียลไทม์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından kamera erişimi isteyeceğiz. Yalnızca kodları gerçek zamanlı okumak için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі ми запитаємо доступ до камери. Він потрібен лише для читання кодів у реальному часі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo, chúng tôi sẽ yêu cầu quyền truy cập camera. Quyền này chỉ dùng để đọc mã trong thời gian thực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来会请求相机权限，仅用于实时识别码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來我們會要求相機存取權限，僅用於即時讀取條碼。"
          }
        }
      }
    },
    "onboarding.create.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نمطًا وألوانًا وشعارك. ثم شاركه أو احفظه في الصور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en stil, farver og dit logo. Del den, eller gem den i Billeder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Stil, Farben und dein Logo. Teile den Code oder speichere ihn in Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
