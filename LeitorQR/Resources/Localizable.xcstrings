    "result.contact.accessDenied.detail": {
      "comment": "Autorize o acesso aos contactos em Ajustes para adicionar este contacto.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة جهة الاتصال هذه، قم بالسماح بالوصول إلى جهات الاتصال في الإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje denne kontakt skal du tillade adgang til Kontakter i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diesen Kontakt hinzuzufügen, erlauben Sie den Zugriff auf Kontakte in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add this contact, allow access to Contacts in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To add this contact, allow access to Contacts in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar este contacto, permita el acceso a Contactos en Configuración."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar este contacto, permita el acceso a Contactos en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä yhteystieto sallimalla yhteystietojen käyttö Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter ce contact, autorisez l'accès aux contacts dans Paramètres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter ce contact, autorisez l'accès aux contacts dans Paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף איש קשר זה, אפשר גישה לאנשי קשר בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संपर्क को जोड़ने के लिए, सेटिंग्स में संपर्कों तक पहुंच की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambahkan kontak ini, izinkan akses ke Kontak di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere questo contatto, consenti l'accesso ai Contatti nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連絡先を追加するには、「設定」で連絡先へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연락처를 추가하려면 설정에서 연락처에 대한 액세스를 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah kenalan ini, benarkan akses kepada Kenalan dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til denne kontakten, gi tilgang til Kontakter i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om dit contact toe te voegen, sta je toegang tot Contacten toe in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać ten kontakt, zezwól na dostęp do Kontaktów w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Contatos em Ajustes para adicionar este contato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar este contacto, permita o acesso aos Contactos nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить этот контакт, разрешите доступ к контактам в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lägga till den här kontakten, tillåt åtkomst till Kontakter i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิ่มผู้ติดต่อนี้ ให้อนุญาตการเข้าถึงผู้ติดต่อในการตั้งค่า"
