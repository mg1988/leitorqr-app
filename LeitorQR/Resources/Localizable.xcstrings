        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas no válidas. La latitud debe estar entre -90 y 90, y la longitud entre -180 y 180."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virheelliset koordinaatit. Leveysasteen on oltava -90–90 ja pituusasteen -180–180."
