    "create.error.invalidCoordinates": {
      "comment": "Coordenadas inválidas",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحداثيات غير صالحة. يجب أن يكون خط العرض بين -90 و90 وخط الطول بين -180 و180."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyldige koordinater. Breddegrad mellem -90 og 90, længdegrad mellem -180 og 180."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Koordinaten. Breitengrad zwischen -90 und 90, Längengrad zwischen -180 und 180."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid coordinates. Latitude must be between -90 and 90, and longitude between -180 and 180."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid coordinates. Latitude must be between -90 and 90, and longitude between -180 and 180."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordenadas no válidas. La latitud debe estar entre -90 y 90, y la longitud entre -180 y 180."
