            "state": "translated",
            "value": "Đây không phải nội dung mã Wi-Fi. Nội dung phải bắt đầu bằng WIFI:."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Wi-Fi 码的内容（应以 WIFI: 开头）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Wi-Fi 條碼內容，必須以 WIFI: 開頭。"
          }
        }
      }
    },
