    "legal.privacy.sec1.body": {
      "comment": "Texto 1 Privacidade",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتاج إلى حساب لاستخدام التطبيق، ولا نطلب اسمك أو رقم هاتفك أو بريدك الإلكتروني أبدًا. التطبيق مجهول تمامًا ولا يستخدم معرّفات إعلانية دائمة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behøver ingen konto, og vi spørger aldrig om navn, telefonnummer eller e-mail. Appen er helt anonym og bruger ingen permanente reklame-id'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst kein Konto, und wir fragen nie nach Name, Telefonnummer oder E-Mail. Die App ist völlig anonym und nutzt keine dauerhaften Werbe-IDs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't need an account to use the app, and we never ask for your name, phone number, or email address. The app is fully anonymous and uses no persistent advertising identifiers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't need an account to use the app, and we never ask for your name, phone number, or email address. The app is fully anonymous and uses no persistent advertising identifiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas cuenta para usar la app y nunca pedimos tu nombre, teléfono ni correo. La app es totalmente anónima y no usa identificadores publicitarios persistentes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas cuenta para usar la app y nunca pedimos tu nombre, teléfono ni correo. La app es totalmente anónima y no usa identificadores publicitarios persistentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tarvitse tiliä, emmekä koskaan kysy nimeäsi, puhelinnumeroasi tai sähköpostiosoitettasi. Sovellus on täysin anonyymi eikä käytä pysyviä mainos tunnisteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas besoin de compte et nous ne demandons jamais votre nom, votre téléphone ou votre e-mail. L'app est totalement anonyme et n'utilise aucun identifiant publicitaire persistant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas besoin de compte et nous ne demandons jamais votre nom, votre téléphone ou votre courriel. L'app est totalement anonyme et n'utilise aucun identifiant publicitaire persistant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין צורך בחשבון, ואנחנו אף פעם לא מבקשים את שמך, מספר הטלפון או כתובת הדוא\"ל שלך. האפליקציה אנונימית לחלוטין ואינה משתמשת במזהי פרסום קבועים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप इस्तेमाल करने के लिए खाते की ज़रूरत नहीं है, और हम कभी आपका नाम, फ़ोन नंबर या ईमेल नहीं माँगते। ऐप पूरी तरह गुमनाम है और कोई स्थायी विज्ञापन पहचानकर्ता नहीं इस्तेमाल करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak perlu akun, dan kami tidak pernah meminta nama, nomor telepon, atau email Anda. Aplikasi sepenuhnya anonim dan tidak memakai pengenal iklan permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve un account e non chiediamo mai nome, telefono o email. L'app è del tutto anonima e non usa identificatori pubblicitari persistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリの利用にあたり、アカウント登録や、氏名、電話番号、メールアドレスの入力は求めません。すべて匿名で利用でき、永続的な広告識別子も使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 사용하는 데 계정이 필요 없으며 이름, 전화번호, 이메일을 절대 요청하지 않습니다. 앱은 완전히 익명이며 영구 광고 식별자를 사용하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak perlu akaun untuk menggunakan app ini, dan kami tidak pernah meminta nama, nombor telefon atau e-mel anda. App ini sepenuhnya anonim dan tidak menggunakan pengecam pengiklanan kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trenger ingen konto, og vi spør aldri om navn, telefonnummer eller e-post. Appen er helt anonym og bruker ingen permanente annonse-ID-er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt geen account nodig en we vragen nooit naar je naam, telefoonnummer of e-mailadres. De app is volledig anoniem en gebruikt geen permanente advertentie-ID's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potrzebujesz konta, a my nigdy nie prosimy o imię, numer telefonu ani e-mail. Aplikacja jest w pełni anonimowa i nie używa trwałych identyfikatorów reklamowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pedimos cadastro de conta, nome, número de telefone nem endereço de e-mail para usar o app. Toda a experiência é anônima e livre de identificadores de publicidade persistentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não precisa de conta e nunca pedimos o seu nome, telefone ou e-mail. A app é totalmente anónima e não usa identificadores publicitários persistentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт не нужен, и мы никогда не спрашиваем имя, телефон или почту. Приложение полностью анонимно и не использует постоянные рекламные идентификаторы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behöver inget konto och vi frågar aldrig efter namn, telefonnummer eller e-post. Appen är helt anonym och använder inga beständiga annons-ID:n."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชีก็ใช้แอปได้ และเราไม่เคยขอชื่อ หมายเลขโทรศัพท์ หรืออีเมลของคุณ แอปไม่ระบุตัวตนโดยสมบูรณ์และไม่ใช้ตัวระบุโฆษณาแบบถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap gerekmez ve adınızı, telefon numaranızı veya e-postanızı asla istemeyiz. Uygulama tamamen anonimdir ve kalıcı reklam tanımlayıcıları kullanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис не потрібен, і ми ніколи не запитуємо ім'я, телефон чи пошту. Застосунок повністю анонімний і не використовує постійні рекламні ідентифікатори."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không cần tài khoản để dùng ứng dụng, và chúng tôi không bao giờ hỏi tên, số điện thoại hay email của bạn. Ứng dụng hoàn toàn ẩn danh và không dùng mã nhận dạng quảng cáo cố định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本 App 无需注册账号，我们也不会要求你提供姓名、电话号码或邮箱地址。整个使用过程是匿名的，不使用持久性广告标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本 App 不需要帳號，我們也從不索取你的姓名、電話號碼或電子郵件。App 完全匿名，且不使用任何持續性的廣告識別碼。"
          }
        }
      }
    },
    "legal.privacy.sec1.title": {
      "comment": "Secção 1 Privacidade",
