        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר סגנון, צבעים ולוגו. לאחר מכן שתף אותו או שמור בתמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शैली, रंग और अपना लोगो चुनें। फिर इसे साझा करें या फ़ोटो में सहेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya, warna, dan logo Anda. Lalu bagikan atau simpan ke Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli stile, colori e logo. Poi condividilo o salvalo in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイル、色、ロゴを選ぶだけ。共有も、写真への保存もすぐにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일, 색상, 로고를 고르세요. 그런 다음 공유하거나 사진에 저장하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya, warna dan logo anda. Kemudian kongsi atau simpan ke Foto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en stil, farger og logoen din. Del den, eller lagre den i Bilder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een stijl, kleuren en je logo. Deel de code of sla hem op in Foto's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl, kolory i logo. Następnie udostępnij kod lub zapisz w Zdjęciach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
