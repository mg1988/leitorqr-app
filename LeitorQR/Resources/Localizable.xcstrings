    "create.pro.previewBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين مجانًا — اشترِ مرة واحدة للحفظ والمشاركة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gratis – køb én gang for at gemme og dele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos ansehen – einmal kaufen, um zu speichern und zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview freely—buy once to save and share."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview freely—buy once to save and share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza gratis: compra una vez para guardar y compartir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza gratis: compra una vez para guardar y compartir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatsele vapaasti – osta kerran tallentaaksesi ja jakaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu gratuit : achetez une fois pour enregistrer et partager."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu gratuit : achetez une fois pour enregistrer et partager."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגה מקדימה בחינם — קנה פעם אחת כדי לשמור ולשתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त में प्रीव्यू करें — सहेजने और साझा करने के लिए एक बार खरीदें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau gratis—beli sekali untuk menyimpan dan membagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima gratuita: acquista una volta per salvare e condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由にお試しいただけます。保存と共有は買い切りの購入後に使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료로 미리보기 — 한 번 구매하면 저장하고 공유할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton percuma—beli sekali untuk simpan dan kongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvis gratis – kjøp én gang for å lagre og dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk gratis: koop één keer om op te slaan en te delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądaj bezpłatnie — kup raz, aby zapisać i udostępnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore à vontade; compre uma vez para salvar e compartilhar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualize à vontade: compre uma vez para guardar e partilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите бесплатно — купите один раз, чтобы сохранить и поделиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsgranska fritt – köp en gång för att spara och dela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูตัวอย่างฟรี — ซื้อครั้งเดียวเพื่อบันทึกและแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleyin: kaydetmek ve paylaşmak için bir kez satın alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте вільно — купіть раз, щоб зберегти й поділитися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước miễn phí — mua một lần để lưu và chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随便试，购买终身版后即可存储和分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費預覽 — 買斷後即可儲存與分享。"
          }
        }
      }
    },
