        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak limitu 10 wejść — zachowaj każdy zeskanowany lub utworzony kod"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
