    "intent.connectWifi.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joins the network described by a Wi-Fi code (text starting with WIFI:). Use it after the “Scan QR Code” action. Returns whether it joined."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi QRコードの内容（WIFI: で始まるテキスト）のネットワークに接続します。「QRコードをスキャン」アクションの後に使えます。接続できたかどうかを返します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta à rede descrita num código Wi-Fi (texto que começa por WIFI:). Use depois da ação «Ler código QR». Devolve se a ligação foi bem-sucedida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传入 Wi-Fi 二维码的内容（以 WIFI: 开头）并连接该网络，可以接在「扫描二维码」动作后面。返回是否连接成功。"
          }
        }
      }
    },
    "intent.connectWifi.notWifi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This isn’t Wi-Fi code content (it should start with WIFI:)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi QRコードの内容ではありません（WIFI: で始まる必要があります）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto não é o conteúdo de um código Wi-Fi (deve começar por WIFI:)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这不是 Wi-Fi 二维码的内容（应以 WIFI: 开头）。"
          }
        }
      }
    },
