            "value": "Reproduce un pitido corto cuando se escanea un código."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un pitido corto cuando se escanea un código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa lyhyen piippauksen, kun koodi skannataan."
          }
        },
        "fr": {
          "stringUnit": {
