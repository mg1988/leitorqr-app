          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse tyyli, värit ja logosi. Jaa se tai tallenna Kuviin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un style, des couleurs et votre logo. Partagez-le ou enregistrez-le dans Photos."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
