    "result.event.accessDenied.detail": {
      "comment": "Autorize o acesso ao calendário em Ajustes para adicionar este evento.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة هذا الحدث، عليك السماح بالوصول إلى التقويم في الإعدادات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje denne begivenhed skal du tillade adgang til Kalender i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dieses Ereignis hinzuzufügen, erlauben Sie den Zugriff auf den Kalender in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add this event, allow access to Calendar in Settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To add this event, allow access to Calendar in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar este evento, permita el acceso al Calendario en Configuración."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar este evento, permita el acceso al Calendario en Configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä tapahtuma sallimalla kalenterin käyttö asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter cet événement, autorisez l'accès au calendrier dans les paramètres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter cet événement, autorisez l'accès au calendrier dans les paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף את האירוע הזה, אפשר גישה ליומן בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ईवेंट को जोड़ने के लिए, सेटिंग्स में कैलेंडर तक पहुंच की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambahkan acara ini, izinkan akses ke Kalender di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere questo evento, consenti l'accesso al Calendario nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予定を追加するには、「設定」でカレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이벤트를 추가하려면 설정에서 캘린더에 대한 액세스를 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah acara ini, benarkan akses kepada Kalendar dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til denne hendelsen, gi tilgang til Kalender i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je deze afspraak wilt toevoegen, geef je toegang tot Agenda in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać to wydarzenie, zezwól na dostęp do Kalendarza w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Calendário em Ajustes para adicionar este evento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar este evento, permita o acesso ao Calendário nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить это событие, разрешите доступ к календарю в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lägga till denna händelse, tillåt åtkomst till Kalender i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเพิ่มกิจกรรมนี้ โปรดอนุญาตให้เข้าถึงปฏิทินในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etkinliği eklemek için Ayarlar'da Takvim'e erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб додати цю подію, дозвольте доступ до календаря в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để thêm sự kiện này, hãy cho phép truy cập vào Lịch trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问日历，才能添加这个日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要新增此活動，請允許存取「設定」中的「日曆」。"
          }
        }
      }
    },
