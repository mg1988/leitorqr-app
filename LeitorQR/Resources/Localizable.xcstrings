        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun limite di 10 voci: conserva ogni codice che scansioni o crei"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10件の上限なしで、すべて保存できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10개 입력 제한 없음 - 스캔하거나 생성한 모든 코드를 유지하세요"
          }
        },
        "ms": {
