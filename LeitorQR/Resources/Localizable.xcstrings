    "scanner.session.error": {
      "comment": "Erro de sessão da câmara",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما في الكاميرا. حاول ثانية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gik noget galt med kameraet. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Kamera ist ein Fehler aufgetreten. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong with the camera. Try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong with the camera. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal con la cámara. Intentar otra vez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal con la cámara. Intentar otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotain meni vikaan kamerassa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est mal passé avec la caméra. Essayer à nouveau."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a mal tourné avec la caméra. Essayer de nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש במצלמה. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे में कुछ गड़बड़ी हुई. पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang tidak beres dengan kameranya. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto con la fotocamera. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラで問題が起きました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에 문제가 발생했습니다. 다시 시도해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuatu telah berlaku dengan kamera. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt med kameraet. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan met de camera. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak z kamerą. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um problema com a câmera. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal com a câmara. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то случилось с камерой. Попробуйте еще раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel med kameran. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีบางอย่างผิดปกติกับกล้อง ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
