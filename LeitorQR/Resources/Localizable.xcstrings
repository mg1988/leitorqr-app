    "legal.terms.sec2.body" : {
      "comment" : "Corpo seção 2 dos termos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR Premium is offered as a one-time purchase with permanent access to all features and no automatic renewal. The applicable price is the one displayed in the App Store at the time of purchase. All payments are processed through your Apple ID via the App Store. A 7-day pass purchased earlier remains valid until it expires."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR Premium は一括購入で、すべての機能を永久にご利用いただけます。自動更新はありません。価格は購入時のApp Storeの表示に準じます。お支払いはApp Storeを通じてお客様のApple IDで処理されます。以前に購入した7日間パスは有効期限まで引き続きご利用いただけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leitor QR Premium é oferecido como compra única, com acesso permanente a todos os recursos e sem renovação automática. O preço em vigor é o exibido na App Store no momento da compra. Todos os pagamentos são processados pela sua conta Apple ID através da App Store. Um passe de 7 dias comprado anteriormente continua válido até expirar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR Premium 以一次性买断形式提供，解锁全部功能且永久有效，不会自动续费。实际价格以购买时 App Store 展示为准。所有付款均通过 App Store 由您的 Apple ID 账户完成。此前购买的 7 天体验卡在其有效期内继续有效。"
          }
        }
      }
    },
    "legal.terms.sec2.title" : {
      "comment" : "Título seção 2 dos termos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
