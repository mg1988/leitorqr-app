      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع مرة واحدة مقابل كل نمط وتاريخ غير محدود وشعارك الخاص. تبقى الأساسيات مجانية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal én gang for hver stil, ubegrænset historie og dit eget logo. Det grundlæggende forbliver gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
