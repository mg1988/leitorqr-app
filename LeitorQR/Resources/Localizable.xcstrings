    "subscription.info.cancel": {
      "comment": "Como cancelar",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إلغاء التجديد التلقائي من خلال Apple. ستحتفظ بالميزات المميزة حتى نهاية الفترة التي دفعت مقابلها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan annullere automatisk fornyelse gennem Apple. Du beholder Premium-funktioner indtil udgangen af ​​den periode, du har betalt for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die automatische Verlängerung über Apple abbrechen. Sie behalten die Premium-Funktionen bis zum Ende des von Ihnen bezahlten Zeitraums."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel auto-renewal through Apple. You'll keep Premium features until the end of the period you've paid for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can cancel auto-renewal through Apple. You'll keep Premium features until the end of the period you've paid for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cancelar la renovación automática a través de Apple. Conservarás las funciones Premium hasta el final del período que hayas pagado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cancelar la renovación automática a través de Apple. Conservarás las funciones Premium hasta el final del período que hayas pagado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit peruuttaa automaattisen uusimisen Applen kautta. Säilytät Premium-ominaisuudet sen jakson loppuun, josta olet maksanut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez annuler le renouvellement automatique via Apple. Vous conserverez les fonctionnalités Premium jusqu’à la fin de la période pour laquelle vous avez payé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez annuler le renouvellement automatique par l'entremise d'Apple. Vous conserverez les fonctionnalités Premium jusqu’à la fin de la période pour laquelle vous avez payé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה יכול לבטל חידוש אוטומטי דרך אפל. אתה תשמור את תכונות הפרימיום עד סוף התקופה ששילמת עליה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Apple के माध्यम से स्वतः नवीनीकरण रद्द कर सकते हैं। आपके द्वारा भुगतान की गई अवधि के अंत तक आप प्रीमियम सुविधाएँ बनाए रखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membatalkan perpanjangan otomatis melalui Apple. Anda akan tetap menggunakan fitur Premium hingga akhir periode pembayaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare il rinnovo automatico tramite Apple. Manterrai le funzionalità Premium fino alla fine del periodo per il quale hai pagato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新はAppleから解約できます。解約後も、お支払い済みの期間が終わるまでPremiumの機能を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple을 통해 자동 갱신을 취소할 수 있습니다. 지불한 기간이 끝날 때까지 프리미엄 기능을 유지하게 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh membatalkan pembaharuan automatik melalui Apple. Anda akan mengekalkan ciri Premium sehingga akhir tempoh yang anda telah bayar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avbryte automatisk fornyelse gjennom Apple. Du beholder Premium-funksjonene til slutten av perioden du har betalt for."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt de automatische verlenging annuleren via Apple. Je behoudt Premium-functies tot het einde van de periode waarvoor je hebt betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz anulować automatyczne odnawianie za pośrednictwem Apple. Funkcje Premium zachowasz do końca okresu, za który zapłaciłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode cancelar a renovação automática pela Apple. Depois de cancelar, você continua com acesso aos recursos Premium até o fim do período já pago."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode cancelar a renovação automática através da Apple. Manterá os recursos Premium até ao final do período pelo qual pagou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете отменить автоматическое продление через Apple. Вы сохраните Премиум-функции до конца оплаченного периода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan avbryta automatisk förnyelse via Apple. Du kommer att behålla Premium-funktionerna till slutet av perioden du har betalat för."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถยกเลิกการต่ออายุอัตโนมัติผ่าน Apple ได้ คุณจะใช้ฟีเจอร์พรีเมียมได้จนกว่าจะสิ้นสุดระยะเวลาที่คุณชำระเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yenilemeyi Apple aracılığıyla iptal edebilirsiniz. Premium özellikleri, ödediğiniz dönemin sonuna kadar kullanmaya devam edeceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете скасувати автоматичне поновлення через Apple. Ви збережете преміум-функції до кінця періоду, за який ви заплатили."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể hủy tự động gia hạn thông qua Apple. Bạn sẽ giữ các tính năng Premium cho đến hết thời gian bạn đã thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以通过 Apple 取消自动续订。取消后，在已付费的周期结束前，你仍可使用 Premium 功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以透過 Apple 取消自動續訂。您將保留高級功能，直到您付費的期限結束。"
          }
        }
      }
    },
    "subscription.info.refund": {
      "comment": "Como pedir reembolso",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لطلب استرداد الأموال، اتصل بشركة Apple من خلال قنوات الدعم الرسمية الخاصة بها. إن إلغاء التجديد التلقائي ليس مثل طلب استرداد الأموال."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at anmode om en refusion skal du kontakte Apple via dets officielle supportkanaler. Annullering af automatisk fornyelse er ikke det samme som at anmode om en refusion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Rückerstattung zu beantragen, wenden Sie sich über die offiziellen Supportkanäle an Apple. Das Abbrechen der automatischen Verlängerung ist nicht dasselbe wie die Beantragung einer Rückerstattung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To request a refund, contact Apple through its official support channels. Canceling auto-renewal isn't the same as requesting a refund."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To request a refund, contact Apple through its official support channels. Canceling auto-renewal isn't the same as requesting a refund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un reembolso, comuníquese con Apple a través de sus canales de soporte oficiales. Cancelar la renovación automática no es lo mismo que solicitar un reembolso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar un reembolso, comuníquese con Apple a través de sus canales de soporte oficiales. Cancelar la renovación automática no es lo mismo que solicitar un reembolso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä hyvitystä ottamalla yhteyttä Appleen sen virallisten tukikanavien kautta. Automaattisen uusimisen peruuttaminen ei ole sama asia kuin hyvityksen pyytäminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour demander un remboursement, contactez Apple via ses canaux d'assistance officiels. Annuler le renouvellement automatique n’est pas la même chose que demander un remboursement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour demander un remboursement, contactez Apple par l'entremise de ses canaux d'assistance officiels. Annuler le renouvellement automatique n'est pas la même chose que demander un remboursement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לבקש החזר, צור קשר עם אפל דרך ערוצי התמיכה הרשמיים שלה. ביטול חידוש אוטומטי אינו זהה לבקשת החזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धनवापसी का अनुरोध करने के लिए, Apple से उसके आधिकारिक सहायता चैनलों के माध्यम से संपर्क करें। स्वतः-नवीनीकरण रद्द करना धनवापसी का अनुरोध करने के समान नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk meminta pengembalian dana, hubungi Apple melalui saluran dukungan resminya. Membatalkan perpanjangan otomatis tidak sama dengan meminta pengembalian dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per richiedere un rimborso, contatta Apple tramite i suoi canali di supporto ufficiali. Annullare il rinnovo automatico non equivale a richiedere un rimborso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金をご希望の場合は、Appleの公式サポートからお問い合わせください。自動更新の解約は返金の申請にはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불을 요청하려면 공식 지원 채널을 통해 Apple에 문의하세요. 자동 갱신을 취소하는 것은 환불을 요청하는 것과 다릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk meminta bayaran balik, hubungi Apple melalui saluran sokongan rasminya. Membatalkan pembaharuan automatik tidak sama dengan meminta bayaran balik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å be om refusjon, kontakt Apple via deres offisielle støttekanaler. Å avbryte automatisk fornyelse er ikke det samme som å be om refusjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u een terugbetaling wilt aanvragen, neemt u contact op met Apple via de officiële ondersteuningskanalen. Het annuleren van automatische verlenging is niet hetzelfde als het aanvragen van een terugbetaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby poprosić o zwrot pieniędzy, skontaktuj się z firmą Apple za pośrednictwem jej oficjalnych kanałów wsparcia. Anulowanie automatycznego odnawiania nie jest równoznaczne z prośbą o zwrot pieniędzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pedir reembolso, entre em contato com a Apple pelos canais oficiais de suporte. Cancelar a renovação não é o mesmo que pedir reembolso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para solicitar o reembolso, contacte a Apple através dos seus canais de suporte oficiais. Cancelar a renovação automática não é o mesmo que solicitar um reembolso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы запросить возврат средств, свяжитесь с Apple через официальные каналы поддержки. Отмена автоматического продления — это не то же самое, что запрос на возврат средств."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att begära en återbetalning, kontakta Apple via dess officiella supportkanaler. Att avbryta automatisk förnyelse är inte detsamma som att begära en återbetalning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการขอเงินคืน โปรดติดต่อ Apple ผ่านช่องทางการสนับสนุนอย่างเป็นทางการ การยกเลิกการต่ออายุอัตโนมัติไม่เหมือนกับการขอเงินคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri ödeme talebinde bulunmak için resmi destek kanalları aracılığıyla Apple ile iletişime geçin. Otomatik yenilemeyi iptal etmek geri ödeme isteğinde bulunmakla aynı şey değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб подати запит на відшкодування, зв’яжіться з Apple через її офіційні канали підтримки. Скасування автоматичного поновлення не те саме, що запит на відшкодування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để yêu cầu hoàn lại tiền, hãy liên hệ với Apple thông qua các kênh hỗ trợ chính thức của Apple. Việc hủy tự động gia hạn không giống như yêu cầu hoàn lại tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需退款，请通过 Apple 官方支持渠道申请。取消续订不等于申请退款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要申請退款，請透過官方支援管道聯絡 Apple。取消自動續訂與要求退款不同。"
          }
        }
      }
    },
