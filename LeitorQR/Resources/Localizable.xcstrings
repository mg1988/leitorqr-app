    "create.location.hint": {
      "comment": "Como obter coordenadas",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس مطوّلًا نقطة في Apple Maps أو Google Maps لنسخ إحداثياتها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på et sted i Apple Maps eller Google Maps for at kopiere koordinaterne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Punkt in Apple Maps oder Google Maps gedrückt, um die Koordinaten zu kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a spot in Apple Maps or Google Maps to copy its coordinates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a spot in Apple Maps or Google Maps to copy its coordinates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un punto en Apple Maps o Google Maps para copiar sus coordenadas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un punto en Apple Maps o Google Maps para copiar sus coordenadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina kohtaa Apple Mapsissa tai Google Mapsissa ja kopioi koordinaatit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un point dans Apple Maps ou Google Maps pour copier ses coordonnées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur un point dans Apple Maps ou Google Maps pour copier ses coordonnées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק לחוץ נקודה ב-Apple Maps או Google Maps כדי להעתיק את הקואורדינטות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशांक कॉपी करने के लिए Apple Maps या Google Maps में किसी जगह को दबाकर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan titik di Apple Maps atau Google Maps untuk menyalin koordinatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un punto in Apple Maps o Google Maps per copiarne le coordinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleマップやAppleマップで場所を長押しすると、座標をコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps 또는 Google Maps에서 지점을 길게 눌러 좌표를 복사하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan titik dalam Apple Maps atau Google Maps untuk menyalin koordinatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold inne et punkt i Apple Maps eller Google Maps for å kopiere koordinatene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een punt in Apple Maps of Google Maps ingedrukt om de coördinaten te kopiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj punkt w Apple Maps lub Google Maps, aby skopiować współrzędne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha pressionado um ponto no Mapas ou no Google Maps para copiar as coordenadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha premido um ponto no Apple Maps ou Google Maps para copiar as coordenadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте точку в Apple Maps или Google Maps, чтобы скопировать координаты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll in en punkt i Apple Maps eller Google Maps för att kopiera koordinaterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะค้างที่จุดใน Apple Maps หรือ Google Maps เพื่อคัดลอกพิกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinatları kopyalamak için Apple Maps veya Google Maps'te bir noktaya basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте точку в Apple Maps чи Google Maps, щоб скопіювати координати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và giữ một điểm trong Apple Maps hoặc Google Maps để sao chép tọa độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“地图”或其他地图 App 中长按某个地点，即可复制它的经纬度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 地圖或 Google 地圖上長按某個位置即可複製座標。"
          }
        }
      }
    },
