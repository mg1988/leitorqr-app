    "legal.privacy.sec4.body": {
      "comment": "Corpo seção 4 da privacidade",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعالج جميع عمليات الشراء بأمان بواسطة Apple عبر App Store (StoreKit 2). لا يستطيع التطبيق الوصول إلى أرقام البطاقات أو كلمات مرور الدفع أو أي بيانات مالية أخرى أو جمعها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle køb behandles sikkert af Apple via App Store (StoreKit 2). Appen kan ikke tilgå eller indsamle kortnumre, betalingsadgangskoder eller andre finansielle oplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Käufe werden sicher von Apple über den App Store (StoreKit 2) abgewickelt. Die App kann keine Kartennummern, Zahlungspasswörter oder andere Finanzdaten abrufen oder sammeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All purchases are processed securely by Apple through the App Store (StoreKit 2). The app can't access or collect card numbers, payment passwords, or any other financial credentials."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All purchases are processed securely by Apple through the App Store (StoreKit 2). The app can't access or collect card numbers, payment passwords, or any other financial credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las compras las procesa Apple de forma segura a través del App Store (StoreKit 2). La app no puede acceder ni recopilar números de tarjeta, contraseñas de pago ni credenciales financieras."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las compras las procesa Apple de forma segura a través del App Store (StoreKit 2). La app no puede acceder ni recopilar números de tarjeta, contraseñas de pago ni credenciales financieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple käsittelee kaikki ostot turvallisesti App Storen (StoreKit 2) kautta. Sovellus ei voi käyttää tai kerätä korttinumeroita, maksusalasanoja tai muita taloustietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les achats sont traités de façon sécurisée par Apple via l'App Store (StoreKit 2). L'app ne peut ni accéder ni collecter les numéros de carte, mots de passe de paiement ou autres identifiants financiers."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les achats sont traités de façon sécurisée par Apple via l'App Store (StoreKit 2). L'app ne peut ni accéder ni collecter les numéros de carte, mots de passe de paiement ou autres identifiants financiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הרכישות מעובדות באופן מאובטח על ידי Apple דרך App Store‏ (StoreKit 2). האפליקציה לא יכולה לגשת או לאסוף מספרי כרטיסים, סיסמת תשלום או פרטי מימון אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी खरीदारी Apple द्वारा App Store (StoreKit 2) के ज़रिए सुरक्षित रूप से संसाधित होती हैं। ऐप कार्ड नंबर, भुगतान पासवर्ड या अन्य वित्तीय जानकारी न पढ़ सकता है न एकत्र कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pembelian diproses dengan aman oleh Apple melalui App Store (StoreKit 2). Aplikasi tidak dapat mengakses atau mengumpulkan nomor kartu, kata sandi pembayaran, atau kredensial finansial lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli acquisti sono elaborati in modo sicuro da Apple tramite l'App Store (StoreKit 2). L'app non può accedere né raccogliere numeri di carta, password di pagamento o altre credenziali finanziarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての購入はApple App Store（StoreKit 2）によって安全に処理されます。本アプリがカード番号、支払い用パスワード、その他の決済情報にアクセスしたり、収集したりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 구매는 Apple이 App Store(StoreKit 2)를 통해 안전하게 처리합니다. 앱은 카드 번호, 결제 비밀번호 또는 기타 금융 정보에 접근하거나 수집할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pembelian diproses dengan selamat oleh Apple melalui App Store (StoreKit 2). App tidak boleh mengakses atau mengumpul nombor kad, kata laluan pembayaran atau kelayakan kewangan lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle kjøp behandles sikkert av Apple via App Store (StoreKit 2). Appen kan ikke få tilgang til eller samle inn kortnumre, betalingspassord eller andre finansielle opplysninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aankopen worden veilig verwerkt door Apple via de App Store (StoreKit 2). De app kan geen kaartnummers, betaalwachtwoorden of andere financiële gegevens opvragen of verzamelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zakupy są bezpiecznie przetwarzane przez Apple przez App Store (StoreKit 2). Aplikacja nie ma dostępu do numerów kart, haseł płatności ani innych danych finansowych i ich nie zbiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as compras são processadas com segurança pela App Store da Apple (StoreKit 2). Este app não tem acesso a números de cartão, senhas de pagamento ou quaisquer credenciais financeiras, nem os coleta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as compras são processadas em segurança pela Apple através da App Store (StoreKit 2). A app não consegue aceder nem recolher números de cartão, palavras-passe de pagamento ou outras credenciais financeiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все покупки безопасно обрабатываются Apple через App Store (StoreKit 2). Приложение не имеет доступа к номерам карт, платёжным паролям и другим финансовым данным и не собирает их."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla köp hanteras säkert av Apple via App Store (StoreKit 2). Appen kan inte komma åt eller samla in kortnummer, betalningslösenord eller andra finansiella uppgifter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อทั้งหมดดำเนินการอย่างปลอดภัยโดย Apple ผ่าน App Store (StoreKit 2) แอปไม่สามารถเข้าถึงหรือเก็บหมายเลขบัตร รหัสผ่านการชำระเงิน หรือข้อมูลทางการเงินอื่นใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm satın almalar Apple tarafından App Store (StoreKit 2) üzerinden güvenle işlenir. Uygulama kart numaralarına, ödeme şifrelerine veya diğer finansal bilgilere erişemez ve bunları toplamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі покупки безпечно обробляються Apple через App Store (StoreKit 2). Застосунок не має доступу до номерів карток, платіжних паролів та інших фінансових даних і не збирає їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi giao dịch mua được Apple xử lý an toàn qua App Store (StoreKit 2). Ứng dụng không thể truy cập hay thu thập số thẻ, mật khẩu thanh toán hoặc thông tin tài chính khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有购买均由 Apple App Store（StoreKit 2）安全处理。本 App 无法访问、也不会收集任何银行卡号、支付密码或其他金融凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有購買均由 Apple 透過 App Store（StoreKit 2）安全處理。本 App 無法存取或收集卡號、付款密碼或任何其他財務憑證。"
          }
        }
      }
    },
