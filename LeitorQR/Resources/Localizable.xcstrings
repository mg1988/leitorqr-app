    "legal.terms.sec4.body" : {
      "comment" : "Texto 4 Termos",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All rights to the design, icons, logos, and technology belong to the app's creator. You are expressly prohibited from using the app to generate codes that lead to malicious content, fraudulent schemes, or that violate applicable law."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デザイン、アイコン、ロゴ、技術に関するすべての権利はアプリ開発者に帰属します。悪意のあるコンテンツ、詐欺的なスキーム、または適用される法令に違反するコードを生成するために本アプリを使用することは、明示的に禁止されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os direitos sobre o design, ícones, logotipos e tecnologia pertencem ao criador do aplicativo. É expressamente proibido usar o aplicativo para gerar códigos que levem a conteúdos maliciosos, esquemas fraudulentos ou que violem a legislação aplicável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用的设计、UI 界面、自绘模板、矢量图标及软件架构均受著作权法保护。您不得使用本应用制作包含恶意软件、钓鱼欺诈或违反国家法律法规的二维码。"
          }
        }
      }
    },
