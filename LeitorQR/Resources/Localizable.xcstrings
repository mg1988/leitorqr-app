    "security.batch.empty.desc": {
      "comment": "Selecione fotos com códigos QR; os links são verificados no seu dispositivo",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الصور التي تحتوي على رموز QR. يتم فحص الروابط على جهازك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg billeder med QR-koder. Links kontrolleres på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Fotos mit QR-Codes. Links werden auf Ihrem Gerät überprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos with QR codes. Links are checked on your device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos with QR codes. Links are checked on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija fotos con códigos QR. Los enlaces se verifican en su dispositivo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija fotos con códigos QR. Los enlaces se verifican en su dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse valokuvat QR-koodeilla. Linkit tarkistetaan laitteellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des photos avec des codes QR. Les liens sont vérifiés sur votre appareil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des photos avec des codes QR. Les liens sont vérifiés sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר תמונות עם קודי QR. הקישורים נבדקים במכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड वाले फ़ोटो चुनें. आपके डिवाइस पर लिंक की जाँच की जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto dengan kode QR. Tautan diperiksa di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le foto con i codici QR. I collegamenti sono controllati sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードが写った写真を選んでください。リンクはデバイス内でチェックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드가 포함된 사진을 선택하세요. 링크는 장치에서 확인됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto dengan kod QR. Pautan disemak pada peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bilder med QR-koder. Linker sjekkes på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies foto's met QR-codes. Links worden gecontroleerd op uw apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcia z kodami QR. Linki są sprawdzane na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione fotos com códigos QR; os links são verificados no seu dispositivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha fotos com códigos QR. Os links são verificados no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте фотографии с QR-кодами. Ссылки проверяются на вашем устройстве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj foton med QR-koder. Länkar kontrolleras på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปภาพที่มีรหัส QR มีการตรวจสอบลิงก์บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodlu fotoğrafları seçin. Bağlantılar cihazınızda kontrol edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть фотографії з QR-кодами. Посилання перевіряються на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh có mã QR. Các liên kết được kiểm tra trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择带二维码的照片，链接会在本机核对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇帶有二維碼的照片。在您的裝置上檢查連結。"
          }
        }
      }
    },
