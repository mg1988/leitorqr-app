          "stringUnit": {
            "state": "translated",
            "value": "이미지를 저장할 수 없습니다. 설정에서 사진 접근 권한을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej tidak dapat disimpan. Semak akses Foto dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre bildet. Sjekk tilgangen til Bilder i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de afbeelding niet opslaan. Controleer de Foto's-toegang in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać obrazu. Sprawdź dostęp do Zdjęć w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a imagem. Verifique o acesso a Fotos em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a imagem. Verifique o acesso às Fotografias nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изображение. Проверьте доступ к Фото в Настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att spara bilden. Kontrollera åtkomsten till Foton i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรูปภาพไม่สำเร็จ ตรวจสอบการเข้าถึงรูปภาพในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel kaydedilemedi. Ayarlar'dan Fotoğraflar erişimini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти зображення. Перевірте доступ до Фото в Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu ảnh. Kiểm tra quyền truy cập Ảnh trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片存储失败。请检查照片访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存圖片。請在「設定」中檢查照片存取權限。"
          }
        }
      }
    },
