        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль, кольори й логотип. Потім поділіться кодом або збережіть його у Фото."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu, màu và logo của bạn. Sau đó chia sẻ hoặc lưu vào Ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
