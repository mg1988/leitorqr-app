          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un estilo, colores y tu logotipo. Luego compártelo o guárdalo en Fotos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
