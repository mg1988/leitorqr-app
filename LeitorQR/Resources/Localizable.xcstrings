          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sejarah semakan akan dialih keluar daripada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "All sjekkhistorikk vil bli fjernet fra denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
