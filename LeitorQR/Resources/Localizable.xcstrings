    "settings.auto.wifi.desc": {
      "comment": "Ao ler um código Wi-Fi, tentar ligar sem abrir o resultado",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول الانضمام عند مسح رمز Wi-Fi، دون إظهار النتيجة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsøger at deltage, når du scanner en Wi-Fi-kode, uden at vise resultatet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versucht beizutreten, wenn Sie einen WLAN-Code scannen, ohne dass das Ergebnis angezeigt wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to join when you scan a Wi-Fi code, without showing the result"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to join when you scan a Wi-Fi code, without showing the result"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta unirse cuando escaneas un código Wi-Fi, sin mostrar el resultado"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta unirse cuando escaneas un código Wi-Fi, sin mostrar el resultado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yrittää liittyä, kun skannaat Wi-Fi-koodin näyttämättä tulosta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie de se connecter lorsque vous scannez un code Wi-Fi, sans afficher le résultat"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de vous connecter lorsque vous scannez un code Wi-Fi, sans voir le résultat"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנסה להצטרף כאשר אתה סורק קוד Wi-Fi, מבלי להציג את התוצאה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप वाई-फ़ाई कोड स्कैन करते हैं, तो परिणाम दिखाए बिना शामिल होने का प्रयास करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencoba bergabung saat Anda memindai kode Wi-Fi, tanpa menunjukkan hasilnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta di connettersi quando si esegue la scansione di un codice Wi-Fi, senza mostrare il risultato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiコードを読み取ったら、結果を表示せずに接続を試みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 코드를 스캔하면 결과가 표시되지 않고 참여를 시도합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba untuk menyertai apabila anda mengimbas kod Wi-Fi, tanpa menunjukkan hasilnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøver å bli med når du skanner en Wi-Fi-kode, uten å vise resultatet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeert deel te nemen wanneer u een Wi-Fi-code scant, zonder het resultaat weer te geven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbuje dołączyć po zeskanowaniu kodu Wi-Fi, bez wyświetlania wyniku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao ler um código Wi-Fi, tenta conectar sem mostrar o resultado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta entrar quando digitalizas um código Wi-Fi, sem mostrar o resultado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытается присоединиться при сканировании кода Wi-Fi, не показывая результат"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försöker gå med när du skannar en Wi-Fi-kod, utan att visa resultatet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามเข้าร่วมเมื่อคุณสแกนรหัส Wi-Fi โดยไม่แสดงผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Wi-Fi kodunu taradığınızda, sonucu göstermeden katılmaya çalışır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Намагається приєднатися, коли ви скануєте код Wi-Fi, але не показує результат"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố gắng tham gia khi bạn quét mã Wi-Fi mà không hiển thị kết quả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫到 Wi-Fi 码时直接尝试连接，不显示结果页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您掃描 Wi-Fi 代碼時嘗試加入，但不顯示結果"
          }
        }
      }
    },
