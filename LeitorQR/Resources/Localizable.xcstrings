    "legal.privacy.summary" : {
      "comment" : "Resumo da privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR is a 100% local, privacy-focused tool. We don't collect, track, or share your personal data or code history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR は 100% ローカルでプライバシーを重視したツールです。お客様の個人情報やコードの履歴を収集、追跡、共有することは一切ありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Leitor QR é uma ferramenta 100% local e voltada para a privacidade. Não coletamos, não rastreamos e não compartilhamos seus dados pessoais ou histórico de códigos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitor QR 遵循极致纯净与完全离线原则。我们绝不收集、不追踪、亦不出售您的任何个人隐私数据或扫描历史。"
          }
        }
      }
    },
