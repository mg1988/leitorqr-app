    "intent.scanWifi.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الماسح وينضم إلى الشبكة بمجرد قراءة رمز واي فاي. يطلب iOS التأكيد مرة واحدة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner scanneren og opretter forbindelse, så snart en Wi-Fi-kode læses. iOS spørger én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Scanner und verbindet sofort, sobald ein WLAN-Code gelesen wird. iOS fragt einmal nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the scanner and joins the network as soon as it reads a Wi-Fi code. iOS asks you to confirm once."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the scanner and joins the network as soon as it reads a Wi-Fi code. iOS asks you to confirm once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el escáner y se conecta en cuanto lee un código Wi-Fi. iOS te pide confirmación una vez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el escáner y se conecta en cuanto lee un código Wi-Fi. iOS te pide confirmación una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa skannerin ja yhdistää heti, kun Wi-Fi-koodi luetaan. iOS kysyy vahvistuksen kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le scanner et rejoint le réseau dès qu'il lit un code Wi-Fi. iOS vous demande de confirmer une fois."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le scanner et rejoint le réseau dès qu'il lit un code Wi-Fi. iOS vous demande de confirmer une fois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את הסורק ומתחבר לרשת ברגע שנקרא קוד Wi-Fi. iOS יבקש אישור פעם אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैनर खोलता है और Wi-Fi कोड पढ़ते ही नेटवर्क से जुड़ जाता है। iOS एक बार पुष्टि माँगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pemindai dan terhubung ke jaringan begitu kode Wi-Fi terbaca. iOS meminta konfirmasi satu kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il lettore e si connette appena legge un codice Wi-Fi. iOS chiede conferma una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り画面を開き、Wi-Fiコードを読み取るとすぐにネットワークに接続します。初回のみiOSの確認があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너를 열고 Wi-Fi 코드를 읽는 즉시 네트워크에 연결합니다. iOS가 한 번 확인을 요청합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pengimbas dan menyambung ke rangkaian sebaik sahaja kod Wi-Fi dibaca. iOS meminta pengesahan sekali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner skanneren og kobler til så snart en Wi-Fi-kode leses. iOS spør én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de scanner en maakt verbinding zodra een wifi-code wordt gelezen. iOS vraagt één keer om bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera skaner i łączy z siecią, gdy tylko odczyta kod Wi-Fi. iOS poprosi o potwierdzenie raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o leitor e conecta à rede assim que lê um código Wi-Fi. O iOS pede uma confirmação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o leitor e liga-se assim que lê um código Wi-Fi. O iOS pede confirmação uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает сканер и подключается, как только считан Wi-Fi-код. iOS спросит подтверждение один раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar skannern och ansluter så snart en Wi-Fi-kod läses. iOS frågar en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตัวสแกนและเชื่อมต่อเครือข่ายทันทีที่อ่านโค้ด Wi-Fi โดย iOS จะขอการยืนยัน หนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıyı açar ve bir Wi-Fi kodu okunduğunda ağa bağlanır. iOS bir kez onay ister."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває сканер і підключається щойно зчитано Wi-Fi-код. iOS запитає підтвердження один раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trình quét và kết nối ngay khi đọc được mã Wi-Fi. iOS sẽ hỏi xác nhận một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开扫码页面，扫到 Wi-Fi 码后立即加入该网络。iOS 会让你确认一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟掃描器，讀到 Wi-Fi 條碼後立即連上網路。iOS 會詢問一次確認。"
          }
        }
      }
    },
