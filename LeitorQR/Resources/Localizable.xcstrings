    "legal.privacy.sec5.body": {
      "comment": "Texto 5 Privacidade",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي التطبيق على أي SDK إعلانات مستهدفة أو أدوات تتبع من أطراف ثالثة. يظل تصفحك واستخدامك خاصًا تمامًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen indeholder ingen SDK'er til målrettet annoncering eller tredjeparts sporingsværktøjer. Din browsing og brug forbliver strengt privat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App enthält keine SDKs für gezielte Werbung und keine Tracking-Tools von Drittanbietern. Dein Surfen und deine Nutzung bleiben streng privat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app contains no targeted advertising SDKs or third-party tracking tools. Your browsing and app use remain strictly private."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app contains no targeted advertising SDKs or third-party tracking tools. Your browsing and app use remain strictly private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no contiene SDK de publicidad dirigida ni herramientas de seguimiento de terceros. Tu navegación y uso de la app son estrictamente privados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no contiene SDK de publicidad dirigida ni herramientas de seguimiento de terceros. Tu navegación y uso de la app son estrictamente privados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei sisällä kohdennetun mainonnan SDK:ita eikä kolmannen osapuolen seurantatyökaluja. Selailusi ja käyttösi pysyvät tiukasti yksityisinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne contient aucun SDK de publicité ciblée ni outil de suivi tiers. Votre navigation et votre usage restent strictement privés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne contient aucun SDK de publicité ciblée ni outil de suivi tiers. Votre navigation et votre usage restent strictement privés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה אינה מכילה SDK לפרסום ממוקד או כלי מעקב של צדדים שלישיים. הגלישה והשימוש שלך נשארים פרטיים לחלוטין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में कोई लक्षित विज्ञापन SDK या तृतीय-पक्ष ट्रैकिंग टूल नहीं हैं। आपकी ब्राउज़िंग और ऐप का उपयोग पूरी तरह निजी रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak memuat SDK iklan bertarget atau alat pelacak pihak ketiga. Penjelajahan dan penggunaan Anda tetap sangat privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non contiene SDK pubblicitari mirati né strumenti di tracciamento di terze parti. La navigazione e l'uso restano strettamente privati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリには、ターゲティング広告用のSDKやサードパーティのトラッキングプラットフォームは含まれていません。お客様の閲覧内容や利用状況は厳密に非公開に保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에는 타깃 광고 SDK나 제3자 추적 도구가 없습니다. 브라우징과 앱 사용은 엄격하게 비공개로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App tidak mengandungi SDK pengiklanan bersasar atau alat penjejakan pihak ketiga. Pelayaran dan penggunaan anda kekal peribadi sepenuhnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen inneholder ingen SDK-er for målrettet annonsering eller sporingsverktøy fra tredjeparter. Surfing og bruk forblir strengt privat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app bevat geen gerichte advertentie-SDK's of trackingtools van derden. Je browsen en gebruik blijven strikt privé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie zawiera SDK reklamy ukierunkowanej ani narzędzi śledzących podmiotów trzecich. Przeglądanie i korzystanie pozostają ściśle prywatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não inclui SDKs de publicidade direcionada nem plataformas de rastreamento de terceiros. Sua navegação e seu uso permanecem estritamente privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app não contém SDK de publicidade direcionada nem ferramentas de rastreio de terceiros. A navegação e a utilização continuam estritamente privadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не содержит SDK таргетированной рекламы и сторонних средств отслеживания. Ваш просмотр и использование остаются строго конфиденциальными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen innehåller inga SDK:er för riktad annonsering eller spårningsverktyg från tredje part. Ditt surfande och din användning förblir strikt privata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปไม่มี SDK โฆษณาแบบเจาะจงหรือเครื่องมือติดตามของบุคคลที่สาม การท่องเว็บและการใช้งานของคุณเป็นส่วนตัวโดยสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hedefli reklam SDK'ları veya üçüncü taraf izleme araçları içermez. Gezinme ve kullanım kesinlikle gizli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не містить SDK таргетованої реклами та сторонніх засобів відстеження. Ваш перегляд і використання залишаються суворо конфіденційними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không chứa SDK quảng cáo nhắm mục tiêu hay công cụ theo dõi của bên thứ ba. Việc duyệt và sử dụng của bạn vẫn hoàn toàn riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不包含定向广告 SDK，也不接入任何第三方追踪平台。你的浏览和使用情况严格保密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不含任何定向廣告 SDK 或第三方追蹤工具，你的瀏覽與使用嚴格保持私密。"
          }
        }
      }
    },
