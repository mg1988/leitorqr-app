    "create.carousel.wifi.subtitle": {
      "comment": "Subtítulo Wi-Fi",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع العملاء والأصدقاء ينضمون إلى شبكتك دون تهجئة كلمة المرور."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad kunder og venner komme på netværket uden at stave adgangskoden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Kunden und Freunde deinem Netz beitreten – ohne Passwortdiktat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let customers and friends join your network—no need to spell out the password."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let customers and friends join your network—no need to spell out the password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta a clientes y amigos a tu red sin dictar la contraseña."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta a clientes y amigos a tu red sin dictar la contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna asiakkaiden ja ystävien liittyä verkkoosi ilman salasanan tavaamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez clients et amis à votre réseau sans dicter le mot de passe."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez clients et amis à votre réseau sans dicter le mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר ללקוחות ולחברים להתחבר לרשת שלך בלי לאיית סיסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्राहकों और दोस्तों को पासवर्ड बोले बिना अपने नेटवर्क से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan pelanggan dan teman bergabung ke jaringan Anda tanpa mengeja kata sandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega clienti e amici alla tua rete senza dettare la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを伝えなくても、お客様や友達がすぐにつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고객과 친구가 비밀번호를 불러주지 않아도 네트워크에 연결되게 하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan pelanggan dan rakan menyertai rangkaian anda tanpa mengeja kata laluan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La kunder og venner koble til nettverket uten å stave passordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat klanten en vrienden met je netwerk verbinden zonder het wachtwoord te spellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz klientów i znajomych z siecią bez literowania hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte clientes e amigos à sua rede sem precisar soletrar a senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte clientes e amigos à sua rede sem soletrar a senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключайте клиентов и друзей к сети, не диктуя пароль."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt kunder och vänner ansluta till nätverket utan att stava lösenordet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ลูกค้าและเพื่อนเชื่อมต่อเครือข่ายของคุณโดยไม่ต้องบอกพาสเวิร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müşteriler ve arkadaşlar şifreyi hecelemeden ağınıza bağlansın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключайте клієнтів і друзів до мережі, не диктуючи пароль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho khách và bạn bè kết nối mạng của bạn mà không cần đọc mật khẩu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客人和朋友扫一下就能连网，不用再报密码。"
          }
