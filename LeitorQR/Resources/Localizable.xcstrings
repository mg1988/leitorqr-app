    "legal.privacy.sec1.body" : {
      "comment" : "Texto 1 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't ask for account registration, your name, phone number, or email address to use the app. The entire experience is anonymous and free of persistent advertising identifiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリのご利用にあたり、アカウント登録、お名前、電話番号、メールアドレスなどは一切お尋ねしません。すべての操作は匿名で行われ、広告識別子などの永続的な識別情報は使用しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não solicitamos registro de conta, nome, número de telefone ou endereço de e-mail para usar o aplicativo. Toda a experiência é anônima e livre de identificadores persistentes de publicidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本应用无需注册账户，我们不索取您的姓名、手机号或个人信息。整个使用过程完全匿名，无任何广告追踪标识符。"
          }
        }
      }
    },
    "legal.privacy.sec1.title" : {
      "comment" : "Secção 1 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zero Collection of Personal Data"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 個人情報の完全非収集"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Zero Coleta de Dados Pessoais"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 零数据收集原则"
          }
        }
      }
    },
    "legal.privacy.sec2.body" : {
      "comment" : "Texto 2 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is accessed only in real time to detect and scan QR and barcodes via the Apple Vision framework. No image or video stream is recorded or transmitted to external servers. Photo library access is requested only when you choose to import an image for scanning or save a generated code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラは Apple Vision フレームワークにより、QR コードやバーコードのリアルタイムな検知・読み取りのみに使用されます。画像や動画が記録されたり、外部サーバーへ送信されたりすることはありません。写真へのアクセスは、画像を取り込んで読み取る場合や、生成したコードを保存する場合にのみ要求されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera é acessada exclusivamente em tempo real para a detecção e leitura de códigos QR e de barras via framework Apple Vision. Nenhuma imagem ou sequência de vídeo é gravada ou transmitida para servidores externos. O acesso às fotos é solicitado apenas quando você decide importar uma imagem para leitura ou salvar um código gerado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机权限仅用于取景器内实时捕捉与识别二维码/条形码。图像流通过 Apple 原生 Vision 框架在设备端本地进行毫秒级光学分析，绝不会录制、缓存或上传到外部服务器。相册权限仅在您主动导入图片扫码或保存自制二维码时使用。"
          }
        }
      }
    },
    "legal.privacy.sec2.title" : {
      "comment" : "Secção 2 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Use of Camera and Photos"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. カメラと写真の使用"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Uso de Câmera e Fotos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 相机与相册权限使用"
          }
        }
      }
    },
    "legal.privacy.sec3.body" : {
      "comment" : "Texto 3 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your scan history and the codes you create are stored locally on your device using the system's internal database. This data never leaves your device, and you can delete it individually or in full at any time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取り履歴と作成したコードは、システム内蔵データベースを使用してデバイス内に保存されます。これらのデータがデバイスの外に出ることはなく、いつでも個別または一括で削除できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico de leitura e os códigos que você cria são salvos localmente no seu dispositivo usando o banco de dados interno do sistema. Esses dados nunca saem do seu dispositivo e você pode excluí-los individualmente ou por completo a qualquer momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的所有扫码记录及自制二维码完全保存在本机系统数据库中，不经过任何云端同步。数据由您完全掌控，您可随时在历史记录中单条删除或一键清空全部数据。"
          }
        }
      }
    },
    "legal.privacy.sec3.title" : {
      "comment" : "Secção 3 Privacidade",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Local-Only Storage"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 完全ローカルでのデータ保存"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Armazenamento Exclusivamente Local"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 纯本地数据存储"
          }
        }
      }
    },
    "legal.privacy.sec4.body" : {
      "comment" : "Corpo seção 4 da privacidade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All purchases are securely processed by the Apple App Store (StoreKit 2). This app cannot access or collect any card numbers, payment passwords, or financial credentials."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての購入はApple App Store（StoreKit 2）によって安全に処理されます。本アプリはカード番号、支払いパスワード、その他の金融情報にアクセスせず、収集もしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as compras são processadas com segurança pela Apple App Store (StoreKit 2). Este aplicativo não acessa, nem coleta números de cartão, senhas de pagamento ou quaisquer credenciais financeiras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有购买均由 Apple App Store (StoreKit 2) 提供高标准安全处理。本应用无法访问、亦不收集任何银行卡号、支付密码或财务凭据。"
          }
        }
      }
    },
