    "legal.terms.sec1.body" : {
      "comment" : "Texto 1 Termos",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We grant you a personal, non-exclusive, non-transferable, and revocable license to install and use Leitor QR on Apple devices associated with your personal account, in accordance with the App Store usage rules."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当方は、App Store の利用規約に従い、お客様の個人アカウントに紐づく Apple デバイスにおいて Leitor QR をインストール・利用するための、個人的、非独占的、譲渡不可、取り消し可能なライセンスを付与します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedemos a você uma licença pessoal, não exclusiva, intransferível e revogável para instalar e usar o Leitor QR em dispositivos Apple associados à sua conta pessoal, em conformidade com as regras de uso da App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发者授予您一项个人的、非排他性的、不可转让的、可撤回的许可，供您在兼容的 Apple 设备上按照 App Store 服务条款使用 Leitor QR。"
          }
        }
      }
    },
    "legal.terms.sec1.title" : {
      "comment" : "Secção 1 Termos",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. License Grant"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. ソフトウェア使用許諾"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
