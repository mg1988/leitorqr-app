    "legal.terms.sec2.body": {
      "comment": "Corpo seção 2 dos termos",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقدَّم Leitor QR Premium كعملية شراء واحدة تمنحك وصولًا دائمًا إلى جميع الميزات، دون تجديد تلقائي. السعر المعمول به هو المعروض في App Store وقت الشراء. تُعالج جميع المدفوعات عبر App Store باستخدام Apple ID الخاص بك. يظل تصريح الـ 7 أيام الذي تم شراؤه سابقًا صالحًا حتى انتهاء صلاحيته."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium tilbydes som et engangskøb med permanent adgang til alle funktioner, uden automatisk fornyelse. Den gældende pris er den, App Store viser ved købet. Alle betalinger behandles af App Store med dit Apple-ID. Et tidligere købt 7-dagspas er gyldigt, indtil det udløber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium ist ein einmaliger Kauf mit dauerhaftem Zugriff auf alle Funktionen, ohne automatische Verlängerung. Es gilt der Preis, der beim Kauf im App Store angezeigt wird. Alle Zahlungen werden vom App Store über deine Apple-ID abgewickelt. Ein früher gekaufter 7-Tage-Pass bleibt bis zum Ablauf gültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium is offered as a one-time purchase that gives you permanent access to all features, with no automatic renewal. The price that applies is the one shown in the App Store at the time of purchase. All payments are processed by the App Store using your Apple ID. A 7-day pass purchased earlier remains valid until it expires."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium is offered as a one-time purchase that gives you permanent access to all features, with no automatic renewal. The price that applies is the one shown in the App Store at the time of purchase. All payments are processed by the App Store using your Apple ID. A 7-day pass purchased earlier remains valid until it expires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium se ofrece como compra única que da acceso permanente a todas las funciones, sin renovación automática. El precio aplicable es el que muestra el App Store al comprar. Todos los pagos los procesa el App Store con tu Apple ID. Un pase de 7 días comprado antes sigue siendo válido hasta que caduque."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium se ofrece como compra única que da acceso permanente a todas las funciones, sin renovación automática. El precio aplicable es el que muestra el App Store al comprar. Todos los pagos los procesa el App Store con tu Apple ID. Un pase de 7 días comprado antes sigue siendo válido hasta que caduque."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium on kertaluonteinen osto, joka antaa pysyvän pääsyn kaikkiin ominaisuuksiin ilman automaattista uusimista. Voimassa oleva hinta on se, jonka App Store näyttää ostohetkellä. Kaikki maksut käsittelee App Store Apple ID:lläsi. Aiemmin ostettu 7 päivän passi on voimassa sen päättymiseen asti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium est proposé en achat unique donnant un accès permanent à toutes les fonctionnalités, sans renouvellement automatique. Le prix applicable est celui affiché dans l'App Store au moment de l'achat. Tous les paiements sont traités par l'App Store avec votre identifiant Apple. Un pass de 7 jours acheté auparavant reste valable jusqu'à expiration."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium est proposé en achat unique donnant un accès permanent à toutes les fonctionnalités, sans renouvellement automatique. Le prix applicable est celui affiché dans l'App Store au moment de l'achat. Tous les paiements sont traités par l'App Store avec votre identifiant Apple. Un pass de 7 jours acheté auparavant reste valable jusqu'à expiration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium מוצע כרכישה חד-פעמית המעניקה גישה קבועה לכל התכונות, ללא חידוש אוטומטי. המחיר החל הוא זה שמוצג ב-App Store בעת הרכישה. כל התשלומים מעובדים על ידי App Store באמצעות ה-Apple ID שלך. כרטיס ל-7 ימים שנרכש קודם לכן נשאר בתוקף עד לפקיעתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium एक बार की खरीद के रूप में पेश किया जाता है जो बिना स्वतः नवीनीकरण के सभी सुविधाओं तक स्थायी पहुँच देता है। लागू मूल्य वही है जो खरीद के समय App Store में दिखता है। सभी भुगतान App Store द्वारा आपकी Apple ID से संसाधित होते हैं। पहले खरीदा गया 7-दिन का पास समाप्ति तक मान्य रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium ditawarkan sebagai pembelian sekali dengan akses permanen ke semua fitur, tanpa perpanjangan otomatis. Harga yang berlaku adalah yang ditampilkan di App Store saat pembelian. Semua pembayaran diproses oleh App Store menggunakan Apple ID Anda. Pas 7 hari yang dibeli sebelumnya tetap berlaku hingga kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium è un acquisto unico che dà accesso permanente a tutte le funzioni, senza rinnovo automatico. Il prezzo applicabile è quello mostrato nell'App Store al momento dell'acquisto. Tutti i pagamenti sono gestiti dall'App Store con il tuo ID Apple. Un pass di 7 giorni acquistato in precedenza resta valido fino alla scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premiumは1回限りの購入（買い切り）で提供され、すべての機能を期限なく利用でき、自動更新はありません。適用される価格は、購入時にApp Storeに表示される価格です。お支払いはすべて、App Storeを通じてお客様のApple IDで処理されます。以前に購入された7日間パスは、有効期限まで引き続き有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium은 자동 갱신 없이 모든 기능을 영구적으로 사용할 수 있는 일회성 구매입니다. 적용되는 가격은 구매 시 App Store에 표시된 가격입니다. 모든 결제는 Apple ID를 통해 App Store에서 처리됩니다. 이전에 구매한 7일 이용권은 만료될 때까지 유효합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium ditawarkan sebagai pembelian sekali dengan akses kekal kepada semua ciri, tanpa pembaharuan automatik. Harga yang terpakai ialah yang dipaparkan dalam App Store semasa pembelian. Semua pembayaran diproses oleh App Store menggunakan Apple ID anda. Pas 7 hari yang dibeli sebelum ini kekal sah sehingga tamat tempoh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium tilbys som et engangskjøp med permanent tilgang til alle funksjoner, uten automatisk fornyelse. Gjeldende pris er den App Store viser ved kjøpet. Alle betalinger behandles av App Store med Apple-ID-en din. Et tidligere kjøpt 7-dagerspass er gyldig til det utløper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium is een eenmalige aankoop met permanente toegang tot alle functies, zonder automatische verlenging. De geldende prijs is de prijs die de App Store op het moment van aankoop toont. Alle betalingen worden door de App Store verwerkt met je Apple ID. Een eerder gekocht pasje van 7 dagen blijft geldig tot het verloopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium to jednorazowy zakup dający stały dostęp do wszystkich funkcji, bez automatycznego odnawiania. Obowiązuje cena pokazana w App Store w chwili zakupu. Wszystkie płatności obsługuje App Store za pomocą Twojego Apple ID. Wcześniej kupiony 7-dniowy bilet pozostaje ważny do wygaśnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor QR Premium é oferecido como compra única, com acesso permanente a todos os recursos e sem renovação automática. O preço aplicável é o exibido na App Store no momento da compra. Todos os pagamentos são processados pela App Store, por meio do seu Apple ID. Um passe de 7 dias comprado anteriormente continua válido até expirar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Leitor QR Premium é uma compra única que dá acesso permanente a todas as funções, sem renovação automática. O preço aplicável é o apresentado na App Store no momento da compra. Todos os pagamentos são processados pela App Store com o seu Apple ID. Um passe de 7 dias comprado antes continua válido até expirar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium предлагается как разовая покупка с постоянным доступом ко всем функциям, без автопродления. Действует цена, показанная в App Store на момент покупки. Все платежи обрабатывает App Store через ваш Apple ID. Ранее купленный 7-дневный пропуск действует до истечения срока."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium erbjuds som ett engångsköp med permanent åtkomst till alla funktioner, utan automatisk förnyelse. Priset som gäller är det som App Store visar vid köpet. Alla betalningar hanteras av App Store med ditt Apple-ID. Ett tidigare köpt 7-dagarspass gäller tills det löper ut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium เป็นการซื้อครั้งเดียวที่ให้สิทธิ์เข้าถึงทุกฟีเจอร์อย่างถาวร ไม่มีการต่ออายุอัตโนมัติ ราคาที่ใช้คือราคาที่แสดงใน App Store ขณะซื้อ การชำระเงินทั้งหมดดำเนินการโดย App Store ด้วย Apple ID ของคุณ บัตร 7 วันที่ซื้อไว้ก่อนหน้านี้ยังคงใช้ได้จนหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium, tüm özelliklere kalıcı erişim sağlayan ve otomatik yenileme içermeyen tek seferlik bir satın alımdır. Geçerli fiyat, satın alma anında App Store'da gösterilen fiyattır. Tüm ödemeler App Store tarafından Apple ID'nizle işlenir. Daha önce satın alınan 7 günlük geçiş, süresi dolana kadar geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium пропонується як одноразова покупка з постійним доступом до всіх функцій, без автопоновлення. Діє ціна, показана в App Store на момент покупки. Усі платежі обробляє App Store через ваш Apple ID. Раніше придбаний 7-денний перепустка діє до завершення терміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium được cung cấp dưới dạng mua một lần, cho quyền truy cập vĩnh viễn vào mọi tính năng, không tự động gia hạn. Giá áp dụng là giá hiển thị trên App Store tại thời điểm mua. Mọi thanh toán do App Store xử lý bằng Apple ID của bạn. Thẻ 7 ngày đã mua trước đó vẫn có hiệu lực cho đến khi hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium 为一次性购买，购买后可永久使用全部功能，不会自动续费。价格以购买时 App Store 显示的为准。所有付款均通过 App Store 由你的 Apple ID 完成。此前购买的 7 天体验卡在到期前继续有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR Premium 為一次性購買，永久解鎖所有功能，不會自動續訂。適用價格為購買當下 App Store 顯示的價格。所有付款均由 App Store 透過你的 Apple ID 處理。先前購買的 7 天體驗卡在到期前仍有效。"
          }
        }
      }
    },
