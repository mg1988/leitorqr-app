    "legal.terms.sec3.body" : {
      "comment" : "Corpo seção 3 dos termos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can restore previous purchases at any time using the \"Restore Purchases\" button on the subscription screen. Refunds are handled exclusively by Apple; request them at reportaproblem.apple.com or via your App Store purchase history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプション画面の「購入を復元」ボタンから、いつでも過去の購入を復元できます。返金はAppleが独占的に処理します。reportaproblem.apple.com またはApp Storeの購入履歴からお申し込みください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode restaurar compras anteriores a qualquer momento usando o botão \"Restaurar compras\" na tela de assinatura. Reembolsos são gerenciados exclusivamente pela Apple; solicite em reportaproblem.apple.com ou através do seu histórico de compras na App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可随时在订阅页面点击「恢复购买」找回已购权益。退款由 Apple 独家处理，请通过 reportaproblem.apple.com 或 App Store 购买记录发起申请。"
          }
        }
      }
    },
