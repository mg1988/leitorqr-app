        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מגבלה של 10 כניסות - שמור כל קוד שאתה סורק או יוצר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई 10-प्रविष्टि सीमा नहीं—आपके द्वारा स्कैन किए गए या बनाए गए प्रत्येक कोड को रखें"
