    "security.clear.confirm.message": {
      "comment": "Todas as verificações serão removidas deste dispositivo",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة سجل الشيكات بالكامل من هذا الجهاز."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Al kontrolhistorik fjernes fra denne enhed."
          }
