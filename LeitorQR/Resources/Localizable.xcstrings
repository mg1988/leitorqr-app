    "result.risk.disclaimer": {
      "comment": "Aviso de verificação de link",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير هذا الفحص فقط إلى الأشياء التي تستحق نظرة ثانية. لا يمكن معرفة ما إذا كان الرابط آمنًا، لذا تأكد من المصدر قبل فتحه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontrol markerer kun ting, der er værd at se endnu en gang. Det kan ikke se, om et link er sikkert, så bekræft kilden, før du åbner det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Prüfung markiert nur Dinge, die einen zweiten Blick wert sind. Es kann nicht festgestellt werden, ob ein Link sicher ist. Bestätigen Sie daher die Quelle, bevor Sie ihn öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This check only flags things worth a second look. It can't tell whether a link is safe, so confirm the source before you open it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This check only flags things worth a second look. It can't tell whether a link is safe, so confirm the source before you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificación solo señala cosas que merecen una segunda mirada. No puede determinar si un enlace es seguro, así que confirme la fuente antes de abrirlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificación solo señala cosas que merecen una segunda mirada. No puede determinar si un enlace es seguro, así que confirme la fuente antes de abrirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tarkistus merkitsee vain asioita, jotka kannattaa tarkastella toisen kerran. Se ei voi kertoa, onko linkki turvallinen, joten vahvista lähde ennen kuin avaat sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vérification ne signale que les éléments qui méritent un deuxième examen. Il ne peut pas dire si un lien est sûr, alors confirmez la source avant de l'ouvrir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vérification ne signale que les éléments qui méritent un deuxième examen. Il ne peut pas dire si un lien est sécuritaire, alors confirmez la source avant de l'ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסימון הזה מסמן רק דברים ששווים מבט שני. זה לא יכול לדעת אם קישור בטוח, אז אשר את המקור לפני שאתה פותח אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह जाँच केवल दोबारा देखने लायक चीज़ों को चिह्नित करती है। यह नहीं बता सकता कि कोई लिंक सुरक्षित है या नहीं, इसलिए इसे खोलने से पहले स्रोत की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan ini hanya menandai hal-hal yang layak untuk dilihat kembali. Itu tidak dapat memastikan apakah suatu tautan aman, jadi konfirmasikan sumbernya sebelum Anda membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo controllo segnala solo le cose che meritano una seconda occhiata. Non può stabilire se un collegamento è sicuro, quindi conferma la fonte prima di aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックは確認すべき点を示すだけで、リンクが安全かどうかは判断できません。開く前に、送信元が信頼できるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 확인은 다시 살펴볼 가치가 있는 항목만 표시합니다. 링크가 안전한지 여부를 알 수 없으므로 열기 전에 출처를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan ini hanya menandakan perkara yang patut dilihat kedua. Ia tidak dapat mengetahui sama ada pautan selamat, jadi sahkan sumbernya sebelum anda membukanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne sjekken flagger bare ting som er verdt en ny titt. Den kan ikke fortelle om en lenke er trygg, så bekreft kilden før du åpner den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze controle markeert alleen dingen die een tweede blik waard zijn. Het kan niet bepalen of een link veilig is, dus bevestig de bron voordat u deze opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To sprawdzenie oznacza tylko rzeczy warte drugiego spojrzenia. Nie jest w stanie określić, czy link jest bezpieczny, dlatego przed jego otwarciem sprawdź źródło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificação só aponta itens para conferir. Ela não garante que o link é seguro — confirme a origem antes de abrir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificação apenas sinaliza coisas que valem uma segunda vista de olhos. Não é possível dizer se um link é seguro; por isso, confirme a fonte antes de abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта проверка только отмечает вещи, на которые стоит обратить внимание. Он не может определить, безопасна ли ссылка, поэтому подтвердите источник, прежде чем открывать ее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna kontroll flaggar bara saker som är värda en andra titt. Den kan inte avgöra om en länk är säker, så bekräfta källan innan du öppnar den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจสอบนี้จะทำเครื่องหมายเฉพาะสิ่งที่ควรค่าแก่การดูครั้งที่สองเท่านั้น ไม่สามารถบอกได้ว่าลิงก์นั้นปลอดภัยหรือไม่ ดังนั้นให้ยืนยันแหล่งที่มาก่อนที่จะเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kontrol yalnızca ikinci kez bakmaya değer şeyleri işaretler. Bir bağlantının güvenli olup olmadığını söyleyemez, bu nedenle açmadan önce kaynağı doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця перевірка позначає лише речі, які варто переглянути. Він не може визначити, чи безпечне посилання, тому підтвердьте джерело, перш ніж відкривати його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc kiểm tra này chỉ gắn cờ những thứ đáng xem lại. Nó không thể biết liệu một liên kết có an toàn hay không, vì vậy hãy xác nhận nguồn trước khi bạn mở nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只标出值得留意的地方，无法判断链接是否安全。确认来源可信后再打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檢查僅標記值得再次查看的內容。它無法判斷連結是否安全，因此在打開連結之前請確認來源。"
          }
        }
      }
    },
