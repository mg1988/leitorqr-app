          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि यह स्वचालित रूप से कनेक्ट नहीं होता है, तो सेटिंग्स › वाई-फ़ाई में ये विवरण दर्ज करें।"
