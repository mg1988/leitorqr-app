    "legal.terms.sec4.body": {
      "comment": "Texto 4 Termos",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود جميع حقوق تصميم التطبيق وأيقوناته وشعاراته وتقنيته إلى منشئه. لا يجوز استخدام التطبيق لإنشاء رموز تؤدي إلى محتوى ضار أو احتيال أو تنتهك القانون المعمول به."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle rettigheder til appens design, ikoner, logoer og teknologi tilhører skaberen. Du må ikke bruge appen til at oprette koder, der fører til skadeligt indhold eller svindel, eller som overtræder gældende lov."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Rechte an Design, Icons, Logos und Technologie der App liegen bei ihrem Ersteller. Du darfst die App nicht nutzen, um Codes zu erstellen, die zu schädlichen Inhalten oder Betrug führen oder geltendes Recht verletzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All rights to the app's design, icons, logos, and technology belong to its creator. You may not use the app to create codes that lead to malicious content or fraudulent schemes, or that violate applicable law."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All rights to the app's design, icons, logos, and technology belong to its creator. You may not use the app to create codes that lead to malicious content or fraudulent schemes, or that violate applicable law."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los derechos sobre el diseño, iconos, logotipos y tecnología de la app pertenecen a su creador. No puedes usar la app para crear códigos que lleven a contenido malicioso o fraudes, ni que infrinjan la ley aplicable."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los derechos sobre el diseño, iconos, logotipos y tecnología de la app pertenecen a su creador. No puedes usar la app para crear códigos que lleven a contenido malicioso o fraudes, ni que infrinjan la ley aplicable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki oikeudet sovelluksen ulkoasuun, kuvakkeisiin, logoihin ja teknologiaan kuuluvat sen tekijälle. Et saa käyttää sovellusta koodien luomiseen haitalliseen sisältöön tai petoksiin johtavasti tai sovellettavaa lakia rikkoen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les droits sur le design, les icônes, les logos et la technologie de l'app appartiennent à leur créateur. Vous ne pouvez pas utiliser l'app pour créer des codes menant à du contenu malveillant ou à des fraudes, ni contraires à la loi applicable."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les droits sur le design, les icônes, les logos et la technologie de l'app appartiennent à leur créateur. Vous ne pouvez pas utiliser l'app pour créer des codes menant à du contenu malveillant ou à des fraudes, ni contraires à la loi applicable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הזכויות לעיצוב, לסמלים, ללוגואים ולטכנולוגיה של האפליקציה שייכות ליוצר שלה. אין להשתמש באפליקציה כדי ליצור קודים שמובילים לתוכן זדוני או להונאות, או שמפרים את החוק החל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के डिज़ाइन, आइकन, लोगो और तकनीक के सभी अधिकार इसके निर्माता के हैं। आप ऐप का उपयोग ऐसे कोड बनाने के लिए नहीं कर सकते जो दुर्भावनापूर्ण सामग्री या धोखाधड़ी की ओर ले जाएँ, या लागू कानून का उल्लंघन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua hak atas desain, ikon, logo, dan teknologi aplikasi milik pembuatnya. Anda tidak boleh memakai aplikasi untuk membuat kode yang mengarah ke konten berbahaya atau penipuan, atau melanggar hukum yang berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i diritti su design, icone, loghi e tecnologia dell'app appartengono al suo creatore. Non puoi usare l'app per creare codici che portino a contenuti dannosi o frodi, o che violino la legge applicabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザイン、アイコン、ロゴ、技術に関するすべての権利は、本アプリの開発者に帰属します。悪意のあるコンテンツや詐欺につながるコード、または適用される法令に違反するコードを本アプリで作成することは、明示的に禁止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 디자인, 아이콘, 로고 및 기술에 대한 모든 권리는 제작자에게 있습니다. 악성 콘텐츠나 사기로 이어지거나 관련 법률을 위반하는 코드를 만드는 데 앱을 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua hak atas reka bentuk, ikon, logo dan teknologi app adalah milik penciptanya. Anda tidak boleh menggunakan app untuk mencipta kod yang membawa kepada kandungan berniat jahat atau penipuan, atau yang melanggar undang-undang yang terpakai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle rettigheter til appens design, ikoner, logoer og teknologi tilhører skaperen. Du må ikke bruke appen til å lage koder som fører til skadelig innhold eller svindel, eller som bryter med gjeldende lov."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle rechten op het ontwerp, de pictogrammen, logo's en technologie van de app berusten bij de maker. Je mag de app niet gebruiken om codes te maken die naar schadelijke inhoud of fraude leiden of die toepasselijk recht schenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszelkie prawa do wyglądu, ikon, logo i technologii aplikacji należą do jej twórcy. Nie możesz używać aplikacji do tworzenia kodów prowadzących do złośliwych treści lub oszustw ani naruszających obowiązujące prawo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os direitos sobre o design, os ícones, os logotipos e a tecnologia pertencem ao criador do app. É expressamente proibido usar o app para gerar códigos que levem a conteúdo malicioso ou a golpes, ou que violem a legislação aplicável."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os direitos sobre o design, ícones, logótipos e tecnologia da app pertencem ao seu criador. Não pode usar a app para criar códigos que levem a conteúdo malicioso ou fraudes, nem que violem a lei aplicável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все права на дизайн, значки, логотипы и технологии приложения принадлежат его создателю. Запрещено использовать приложение для создания кодов, ведущих к вредоносному контенту или мошенничеству либо нарушающих применимое право."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla rättigheter till appens design, ikoner, logotyper och teknik tillhör skaparen. Du får inte använda appen för att skapa koder som leder till skadligt innehåll eller bedrägerier, eller som bryter mot tillämplig lag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ทั้งหมดในดีไซน์ ไอคอน โลโก้ และเทคโนโลยีของแอปเป็นของผู้สร้าง คุณต้องไม่ใช้แอปสร้างโค้ดที่นำไปสู่เนื้อหาอันตรายหรือการฉ้อโกง หรือที่ฝ่าฝืนกฎหมายที่ใช้บังคับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın tasarımı, simgeleri, logoları ve teknolojisiyle ilgili tüm haklar yaratıcısına aittir. Uygulamayı kötü amaçlı içeriğe veya dolandırıcılığa yol açan ya da yürürlükteki hukuku ihlal eden kodlar oluşturmak için kullanamazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі права на дизайн, значки, логотипи й технології застосунку належать його творцю. Заборонено використовувати застосунок для створення кодів, що ведуть до шкідливого вмісту чи шахрайства або порушують застосовне право."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quyền về thiết kế, biểu tượng, logo và công nghệ của ứng dụng thuộc về người tạo ra nó. Bạn không được dùng ứng dụng để tạo mã dẫn đến nội dung độc hại hoặc lừa đảo, hoặc vi phạm pháp luật hiện hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 的设计、图标、标志和技术的全部权利归 App 开发者所有。严禁使用本 App 生成指向恶意内容、欺诈活动或违反适用法律的码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 的設計、圖示、標誌與技術的所有權利均屬其創作者。你不得使用本 App 製作導向惡意內容、詐騙或違反適用法律的條碼。"
          }
        }
      }
    },
