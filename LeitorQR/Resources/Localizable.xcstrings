    "history.searchEmpty.message": {
      "comment": "Sem resultados para pesquisa",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إدخالات تطابق «%@».\nتحقق من الإملاء أو جرّب بحثًا آخر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen elementer matcher »%@«.\nTjek stavningen, eller prøv en anden søgning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Eintrag passt zu „%@“.\nPrüfe die Schreibweise oder suche anders."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entries match “%@”.\nCheck the spelling or try a different search."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No entries match “%@”.\nCheck the spelling or try a different search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna entrada coincide con «%@».\nRevisa la ortografía o prueba otra búsqueda."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna entrada coincide con «%@».\nRevisa la ortografía o prueba otra búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei merkintöjä haulle ”%@”.\nTarkista kirjoitusasu tai kokeile toista hakua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée ne correspond à « %@ ».\nVérifiez l'orthographe ou essayez une autre recherche."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée ne correspond à « %@ ».\nVérifiez l'orthographe ou essayez une autre recherche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין רשומות שמתאימות ל״%@״.\nבדוק את האיות או נסה חיפוש אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” से कोई प्रविष्टि मेल नहीं खाती।\nवर्तनी जाँचें या अलग खोज आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada entri yang cocok dengan “%@”.\nPeriksa ejaan atau coba pencarian lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce corrisponde a «%@».\nControlla l'ortografia o prova un'altra ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致する履歴はありません。\nつづりを確認するか、別のキーワードで検索してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”과 일치하는 항목이 없습니다.\n철자를 확인하거나 다른 검색어를 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada entri sepadan dengan “%@”.\nSemak ejaan atau cuba carian lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen elementer samsvarer med «%@».\nSjekk stavemåten eller prøv et annet søk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen items gevonden voor ‘%@’.\nControleer de spelling of probeer iets anders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów dla „%@”.\nSprawdź pisownię lub spróbuj inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registro encontrado para \"%@\".\nConfira a ortografia ou tente outras palavras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registo corresponde a «%@».\nVerifique a ortografia ou tente outra pesquisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет записей по запросу «%@».\nПроверьте написание или измените запрос."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen poster matchar ”%@”.\nKontrollera stavningen eller sök på annat sätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการที่ตรงกับ “%@”\nตรวจสอบการสะกดหรือลองค้นหาอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ile eşleşen kayıt yok.\nYazımı kontrol edin veya farklı bir arama deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає записів за запитом «%@».\nПеревірте написання або змініть запит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mục nào khớp với “%@”.\nKiểm tra chính tả hoặc thử tìm khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到与“%@”相关的记录。\n检查一下拼写，或换个关键词试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
