    "templates.adjustHint": {
      "comment": "Alterar manualmente limpa o modelo",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك ضبط الألوان والأشكال النقطية والاحتفاظ بزخارف القالب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan finjustere farver og prikformer og beholde skabelonens dekorationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Farben und Punktformen optimieren und die Dekorationen der Vorlage beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can fine-tune colors and dot shapes and keep the template's decorations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can fine-tune colors and dot shapes and keep the template's decorations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ajustar los colores y las formas de los puntos y conservar las decoraciones de la plantilla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ajustar los colores y las formas de los puntos y conservar las decoraciones de la plantilla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit hienosäätää värejä ja pistemuotoja ja säilyttää mallin koristeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez affiner les couleurs et les formes des points et conserver les décorations du modèle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez affiner les couleurs et les formes des points et conserver les décorations du modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לכוונן צבעים וצורות נקודות ולשמור על עיטורי התבנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप रंगों और बिंदु आकृतियों को ठीक-ठाक कर सकते हैं और टेम्पलेट की सजावट बनाए रख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menyempurnakan warna dan bentuk titik serta mempertahankan dekorasi templat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile ottimizzare i colori e la forma dei punti e mantenere le decorazioni del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートの装飾はそのままで、色やドットの形を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상과 점 모양을 미세 조정하고 템플릿의 장식을 유지할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memperhalusi warna dan bentuk titik serta mengekalkan hiasan templat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan finjustere farger og punktformer og beholde malens dekorasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt kleuren en puntvormen verfijnen en de decoraties van de sjabloon behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dostosować kolory i kształty kropek oraz zachować dekoracje szablonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ajustar as cores e a forma dos pontos sem perder a decoração do modelo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ajustar cores e formas de pontos e manter as decorações do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете точно настроить цвета и формы точек, сохранив украшения шаблона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan finjustera färger och prickformer och behålla mallens dekorationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถปรับแต่งสีและรูปร่างจุดและเก็บการตกแต่งของเทมเพลตไว้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renklere ve nokta şekillerine ince ayar yapabilir ve şablonun dekorasyonlarını koruyabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете точно налаштувати кольори та форми точок і зберегти прикраси шаблону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tinh chỉnh màu sắc và hình dạng chấm cũng như giữ nguyên các phần trang trí của mẫu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以调整颜色和码点形状，模板装饰会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以微調顏色和點形狀並保留模板的裝飾。"
          }
        }
      }
    },
