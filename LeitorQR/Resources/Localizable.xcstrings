    "result.possibleUnsafeLink": {
      "comment": "Aviso de ligação",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من العنوان قبل فتحه. لا يمكن لهذا التطبيق التحقق مما إذا كان الموقع آمنًا أم لا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek adressen, før du åbner den. Denne app kan ikke bekræfte, om et websted er sikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Adresse, bevor Sie sie öffnen. Diese App kann nicht überprüfen, ob eine Website sicher ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the address before you open it. This app can't verify whether a site is safe."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the address before you open it. This app can't verify whether a site is safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la dirección antes de abrirla. Esta aplicación no puede verificar si un sitio es seguro."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la dirección antes de abrirla. Esta aplicación no puede verificar si un sitio es seguro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista osoite ennen kuin avaat sen. Tämä sovellus ei voi vahvistaa, onko sivusto turvallinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'adresse avant de l'ouvrir. Cette application ne peut pas vérifier si un site est sûr."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'adresse avant de l'ouvrir. Cette application ne peut pas vérifier si un site est sûr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את הכתובת לפני שאתה פותח אותה. האפליקציה הזו לא יכולה לאמת אם אתר בטוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे खोलने से पहले पता जांच लें। यह ऐप यह सत्यापित नहीं कर सकता कि कोई साइट सुरक्षित है या नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa alamatnya sebelum Anda membukanya. Aplikasi ini tidak dapat memverifikasi apakah suatu situs aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l'indirizzo prima di aprirlo. Questa app non può verificare se un sito è sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く前にURLを確認してください。このアプリはサイトが安全かどうかを確認しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개봉하기 전에 주소를 확인하세요. 이 앱은 사이트가 안전한지 확인할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak alamat sebelum anda membukanya. Apl ini tidak dapat mengesahkan sama ada tapak itu selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk adressen før du åpner den. Denne appen kan ikke bekrefte om et nettsted er trygt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het adres voordat u het opent. Deze app kan niet verifiëren of een site veilig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź adres zanim go otworzysz. Ta aplikacja nie może sprawdzić, czy witryna jest bezpieczna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o endereço antes de abrir. Este app não verifica se o site é seguro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o endereço antes de o abrir. Esta aplicação não pode verificar se um site é seguro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте адрес, прежде чем открыть его. Это приложение не может проверить, безопасен ли сайт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera adressen innan du öppnar den. Den här appen kan inte verifiera om en webbplats är säker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบที่อยู่ก่อนเปิด แอปนี้ตรวจสอบไม่ได้ว่าไซต์ปลอดภัยหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmadan önce adresi kontrol edin. Bu uygulama bir sitenin güvenli olup olmadığını doğrulayamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте адресу, перш ніж відкривати її. Ця програма не може перевірити, чи безпечний сайт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra địa chỉ trước khi bạn mở nó. Ứng dụng này không thể xác minh xem một trang web có an toàn hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开前请先确认网址。本 App 无法判断网站是否安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開之前檢查地址。此應用程式無法驗證網站是否安全。"
          }
        }
      }
    },
    "result.proHint.body": {
      "comment": "O PRO inclui histórico ilimitado, detecção de risco e leitura em lote.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف PRO سجلاً غير محدود، وعمليات فحص الروابط، ومسح الدفعات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO tilføjer ubegrænset historie, linkkontrol og batchscanning."
          }
        },
