        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thiết bị không tự động kết nối, hãy nhập các chi tiết này vào Cài đặt > Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果没有自动连上，请前往“设置” › “无线局域网”，按以上信息手动加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
