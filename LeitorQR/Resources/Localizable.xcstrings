    "onboarding.scan.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رموز QR والرموز الشريطية وWi-Fi وجهات الاتصال. يتم وضع علامة على الروابط المشبوهة قبل فتحها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-koder, stregkoder, Wi-Fi og kontakter. Mistænkelige links bliver markeret, før du åbner dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Codes, Barcodes, WLAN und Kontakte. Verdächtige Links werden markiert, bevor Sie sie öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QR codes, barcodes, Wi‑Fi, and contacts. Suspicious links get flagged before you open them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "QR codes, barcodes, Wi‑Fi, and contacts. Suspicious links get flagged before you open them."
          }
