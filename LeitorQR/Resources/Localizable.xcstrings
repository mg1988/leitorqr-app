      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الروابط بدون علامات حمراء في متصفحك. الروابط التي تم وضع علامة عليها لا تزال تسأل أولاً."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner links uden røde flag i din browser. Markerede links spørger stadig først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Links ohne rote Flaggen in Ihrem Browser. Gekennzeichnete Links fragen weiterhin zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens links with no red flags in your browser. Flagged links still ask first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens links with no red flags in your browser. Flagged links still ask first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre enlaces sin señales de alerta en su navegador. Los enlaces marcados siguen preguntando primero."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre enlaces sin señales de alerta en su navegador. Los enlaces marcados siguen preguntando primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa linkit ilman punaisia ​​lippuja selaimessasi. Liputetut linkit kysyvät silti ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre des liens sans drapeaux rouges dans votre navigateur. Les liens signalés demandent toujours en premier."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre des liens sans drapeaux rouges dans ton navigateur. Les liens signalés demandent toujours en premier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח קישורים ללא דגלים אדומים בדפדפן שלך. קישורים מסומנים עדיין שואלים קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ब्राउज़र में बिना किसी लाल झंडे वाले लिंक खोलता है। फ़्लैग किए गए लिंक अभी भी पहले पूछे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka tautan tanpa tanda bahaya di browser Anda. Tautan yang ditandai masih ditanyakan terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre collegamenti senza segnali di allarme nel tuo browser. I collegamenti contrassegnati continuano a chiedere prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題のないリンクはブラウザで開きます。疑わしいリンクは開く前に確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에 위험 신호가 없는 링크를 엽니다. 플래그가 지정된 링크는 여전히 먼저 묻습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pautan tanpa bendera merah dalam penyemak imbas anda. Pautan yang dibenderakan masih bertanya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner lenker uten røde flagg i nettleseren din. Flaggede lenker spør fortsatt først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent links zonder rode vlaggen in uw browser. Gemarkeerde links vragen nog steeds eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera linki bez czerwonych flag w przeglądarce. Oflagowane linki nadal pytają jako pierwsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre links seguros no navegador; os suspeitos ainda pedem confirmação"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre links sem sinais de alerta no seu browser. Os links sinalizados ainda perguntam primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает ссылки без красных флажков в вашем браузере. Помеченные ссылки по-прежнему спрашивают в первую очередь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar länkar utan röda flaggor i din webbläsare. Flaggade länkar frågar fortfarande först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดลิงก์โดยไม่มีธงสีแดงในเบราว์เซอร์ของคุณ ลิงก์ที่ถูกตั้งค่าสถานะยังคงถามก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıları tarayıcınızda kırmızı bayrak olmadan açar. İşaretli bağlantılar hâlâ ilk önce soruyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває посилання без червоних прапорців у вашому браузері. Позначені посилання все ще запитують першими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở các liên kết không có cờ đỏ trong trình duyệt của bạn. Liên kết được gắn cờ vẫn hỏi trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全链接直接用浏览器打开，可疑链接仍会先让你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器中開啟沒有危險訊號的連結。標記的連結仍然首先詢問。"
          }
        }
      }
    },
