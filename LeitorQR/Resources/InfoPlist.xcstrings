            "state": "translated",
            "value": "LeitorQR"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许访问摄像头以扫描二维码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera para ler códigos QR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access to scan QR codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取るためにカメラへのアクセスを許可してください。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你创建的二维码保存到相册。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve os códigos QR que você criar na sua galeria de fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the QR codes you create to your photo library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したQRコードを写真ライブラリに保存します。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "Permita o acesso aos contactos para guardar os dados lidos de um código QR.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos contactos para guardar os dados lidos de um código QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问通讯录，以便把二维码里的联系人信息保存下来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to Contacts so contact details read from a QR code can be saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードから読み取った連絡先を保存するため、連絡先へのアクセスを許可してください。"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Permita o acesso ao calendário para adicionar eventos lidos de um código QR.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao calendário para adicionar eventos lidos de um código QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许写入日历，以便把二维码里的事件添加为日程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow writing to Calendar so events read from a QR code can be added."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR コードから読み取った予定を追加するため、カレンダーへの書き込みを許可してください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
