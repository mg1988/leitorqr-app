    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR 需要使用相机来扫描二维码和条形码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera para ler códigos QR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR uses the camera to scan QR codes and barcodes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードやバーコードを読み取るために、カメラを使用します。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR uses the camera to scan QR codes and barcodes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR usa la cámara para escanear códigos QR y códigos de barras."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR usa la cámara para escanear códigos QR y códigos de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilise l'appareil photo pour scanner les codes QR et les codes-barres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilise la caméra pour scanner les codes QR et les codes-barres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR nutzt die Kamera zum Scannen von QR-Codes und Barcodes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilizza la fotocamera per scansionare codici QR e codici a barre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utiliza a câmara para digitalizar códigos QR e códigos de barras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR gebruikt de camera om QR-codes en barcodes te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR wykorzystuje kamerę do skanowania kodów QR i kreskowych."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR använder kameran för att skanna QR-koder och streckkoder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR bruger kameraet til at scanne QR-koder og stregkoder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR bruker kameraet til å skanne QR-koder og strekkoder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR käyttää kameraa QR-koodien ja viivakoodien skannaamiseen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR использует камеру для сканирования QR-кодов и штрих-кодов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR використовує камеру для сканування QR-кодів і штрих-кодів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR, QR kodlarını ve barkodları taramak için kamerayı kullanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Leitor QR الكاميرا لمسح رموز QR والرموز الشريطية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR משתמש במצלמה כדי לסרוק קודי QR וברקודים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR QR कोड और बारकोड को स्कैन करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR menggunakan kamera untuk memindai kode QR dan barcode."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR menggunakan kamera untuk mengimbas kod QR dan kod bar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR sử dụng camera để quét mã QR và mã vạch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR ใช้กล้องเพื่อสแกนรหัส QR และบาร์โค้ด"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR는 카메라를 사용하여 QR 코드와 바코드를 스캔합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR使用相機掃描二維碼和條碼。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你生成的二维码存储到照片。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve em Fotos os códigos QR que você criar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR saves the codes you create to Photos."
          }
        },
        "ja": {
