    "NSContactsUsageDescription": {
      "comment": "Permita o acesso aos contactos para guardar os dados lidos de um código QR.",
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos Contatos para salvar os dados de contato lidos em um código QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问通讯录，才能把二维码中的联系人信息存入通讯录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR uses Contacts to save contact details from codes you scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードから読み取った連絡先を保存するために、連絡先へのアクセスを使用します。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR uses Contacts to save contact details from codes you scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR usa Contactos para guardar los detalles de contacto de los códigos que escanea."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR usa Contactos para guardar los detalles de contacto de los códigos que escanea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilise les contacts pour enregistrer les détails des contacts des codes que vous numérisez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilise les contacts pour enregistrer les détails des contacts des codes que vous numérisez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR verwendet Kontakte, um Kontaktdaten aus den von Ihnen gescannten Codes zu speichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utilizza Contatti per salvare i dettagli dei contatti dai codici scansionati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR utiliza Contactos para guardar os dados de contacto dos códigos que digitaliza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR gebruikt Contacten om contactgegevens op te slaan van codes die u scant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR wykorzystuje Kontakty do zapisywania danych kontaktowych ze skanowanych kodów."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR använder Kontakter för att spara kontaktinformation från koder du skannar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR bruger Kontakter til at gemme kontaktoplysninger fra koder, du scanner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR bruker Kontakter til å lagre kontaktdetaljer fra koder du skanner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR käyttää Yhteystiedot tallentaakseen yhteystiedot skannaamistasi koodeista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR использует Контакты для сохранения контактной информации из сканируемых вами кодов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR використовує Контакти, щоб зберігати контактні дані зі сканованих кодів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitor QR, taradığınız kodlardaki kişi ayrıntılarını kaydetmek için Kişiler'i kullanır."
          }
        },
        "ar": {
